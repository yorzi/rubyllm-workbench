# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle
/vendor/bundle

# Ignore JavaScript dependencies and build caches.
/node_modules

# Ignore all environment files.
/.env*
!/.env.example

# Product specifications live outside this public application repository.
/specs/

# Operating system metadata.
.DS_Store

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets
/public/vite/
/public/vite-dev
/public/vite-test

# Ignore key files for decrypting credentials and more.
/config/*.key
/config/credentials/*.key

# Credentials are per installation: each user creates their own with
# `bin/rails credentials:edit` or uses environment variables.
/config/credentials.yml.enc
/config/credentials/*.yml.enc


/app/assets/builds/*
!/app/assets/builds/.keep
