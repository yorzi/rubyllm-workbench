<% content_for :title, "Edit #{@agent_definition.name} · #{@project.name}" %>
<%= render "shared/shell", active: "agents", project: @project do %>
  <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← #{@agent_definition.name}", project_agent_definition_path(@project, @agent_definition), class: "text-xs font-medium text-accent hover:underline" %>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">Edit agent</h1>
    <p class="mt-2 text-sm leading-6 text-muted">Current revision <span class="font-mono">v<%= @agent_definition.revision %></span>. Saving a definition change advances its revision.</p>
    <%= render "form" %>
  </div>
<% end %>
