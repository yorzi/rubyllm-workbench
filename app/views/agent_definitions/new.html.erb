<% content_for :title, "New agent · #{@project.name}" %>
<%= render "shared/shell", active: "agents", project: @project do %>
  <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Agents", project_agent_definitions_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">New agent</h1>
    <p class="mt-2 text-sm leading-6 text-muted">Create a reusable project-scoped definition. Each edit creates a new revision.</p>
    <%= render "form" %>
  </div>
<% end %>
