<%= form_with model: [@project, @agent_definition], class: "mt-8 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" do |form| %>
  <% if @agent_definition.errors.any? %>
    <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm leading-5 text-rose-700"><%= @agent_definition.errors.full_messages.to_sentence %></div>
  <% end %>

  <div>
    <%= form.label :name, "Agent name", class: "text-xs font-medium text-ink" %>
    <%= form.text_field :name, required: true, maxlength: 160, placeholder: "e.g. Research assistant", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
  </div>

  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :provider, "Provider", class: "text-xs font-medium text-ink" %>
      <%= form.text_field :provider, required: true, maxlength: 80, placeholder: "openrouter", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 font-mono text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
    </div>
    <div>
      <%= form.label :model_id, "Model ID", class: "text-xs font-medium text-ink" %>
      <%= form.text_field :model_id, required: true, maxlength: 240, placeholder: "openrouter/free", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 font-mono text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
    </div>
  </div>
  <p class="mt-2 text-xs leading-5 text-muted">Use the provider slug and model ID shown in <%= link_to "Model Explorer", models_path(project_id: @project.slug), class: "font-medium text-accent hover:underline" %>. Saving a definition does not verify provider credentials.</p>

  <div class="mt-5">
    <%= form.label :instructions, "Instructions", class: "text-xs font-medium text-ink" %>
    <%= form.text_area :instructions, required: true, maxlength: AgentDefinition::MAX_INSTRUCTIONS_LENGTH, rows: 8, placeholder: "Describe the agent's role, boundaries, and expected behavior.", class: "mt-2 w-full resize-y rounded-lg border border-line bg-white px-3 py-2.5 text-sm leading-6 outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
  </div>

  <fieldset class="mt-6">
    <legend class="text-xs font-medium text-ink">Local tools</legend>
    <p class="mt-1 text-xs leading-5 text-muted">Choose from the registered, enabled Ruby tools in this Project. Browser input cannot add tool code. The selected model must declare <code>function_calling</code> in RubyLLM's chat registry; that metadata does not verify live provider acceptance.</p>
    <%= hidden_field_tag "agent_definition[tool_keys][]", "" %>
    <div class="mt-3 grid gap-2 sm:grid-cols-2">
      <% @available_tools.each do |tool| %>
        <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-line bg-white px-3 py-3 hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
          <%= check_box_tag "agent_definition[tool_keys][]", tool.key, @agent_definition.tool_keys.include?(tool.key), class: "mt-0.5 rounded border-line text-accent focus:ring-accent" %>
          <span class="min-w-0"><span class="block text-xs font-medium text-ink"><%= tool.name %></span><span class="mt-1 block font-mono text-[10px] text-muted"><%= tool.key %></span><span class="mt-1 block text-[10px] leading-4 text-muted"><%= tool.description %></span></span>
        </label>
      <% end %>
      <% if @available_tools.empty? %>
        <p class="rounded-lg border border-dashed border-line p-3 text-xs text-muted">No enabled local tools are available.</p>
      <% end %>
    </div>
    <% disabled_selected_tools = @agent_definition.tool_keys - @available_tools.map(&:key) %>
    <% if disabled_selected_tools.any? %>
      <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">Previously selected tools are currently disabled: <span class="font-mono"><%= disabled_selected_tools.join(", ") %></span>. Saving without reselecting them removes them from this definition.</p>
    <% end %>
  </fieldset>

  <fieldset class="mt-6">
    <legend class="text-xs font-medium text-ink">Provider tools</legend>
    <p class="mt-1 text-xs leading-5 text-muted">Only explicitly supported provider-side tools can be selected.</p>
    <%= hidden_field_tag "agent_definition[provider_tools][]", "" %>
    <label class="mt-3 flex cursor-pointer items-start gap-3 rounded-lg border border-line bg-white px-3 py-3 hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
      <%= check_box_tag "agent_definition[provider_tools][]", "web_search", @agent_definition.provider_tools.include?("web_search"), class: "mt-0.5 rounded border-line text-accent focus:ring-accent" %>
      <span><span class="block text-xs font-medium text-ink">Web search</span><span class="mt-1 block text-[10px] leading-4 text-muted">Provider-hosted search; availability depends on the selected provider and model.</span></span>
    </label>
  </fieldset>

  <fieldset class="mt-6 rounded-xl border border-line bg-canvas p-4">
    <legend class="px-1 text-xs font-medium text-ink">Safe generation options</legend>
    <p class="text-xs leading-5 text-muted">Only temperature and maximum output tokens are saved. Blank fields leave provider defaults in effect.</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <%= label_tag "agent_definition_options_temperature", "Temperature (0–2)", class: "text-xs font-medium text-ink" %>
        <%= number_field_tag "agent_definition[options][temperature]", @agent_definition.options["temperature"], min: 0, max: 2, step: 0.01, id: "agent_definition_options_temperature", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 font-mono text-sm focus:border-accent focus:outline-none" %>
      </div>
      <div>
        <%= label_tag "agent_definition_options_max_output_tokens", "Maximum output tokens (1–200000)", class: "text-xs font-medium text-ink" %>
        <%= number_field_tag "agent_definition[options][max_output_tokens]", @agent_definition.options["max_output_tokens"], min: 1, max: 200000, step: 1, id: "agent_definition_options_max_output_tokens", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 font-mono text-sm focus:border-accent focus:outline-none" %>
      </div>
    </div>
  </fieldset>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5">
    <%= link_to "Cancel", @agent_definition.persisted? ? project_agent_definition_path(@project, @agent_definition) : project_agent_definitions_path(@project), class: "text-sm text-muted hover:text-ink" %>
    <%= form.submit @agent_definition.persisted? ? "Save revision" : "Create agent", class: "inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
  </div>
<% end %>
