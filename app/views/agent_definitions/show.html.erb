<% content_for :title, "#{@agent_definition.name} · #{@project.name}" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Agent inspector</p>
      <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">v<%= @agent_definition.revision %></span>
    </div>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <h2 class="text-sm font-semibold text-ink"><%= @agent_definition.name %></h2>
      <p class="mt-2 break-all font-mono text-xs leading-5 text-muted"><%= @agent_definition.provider %> / <%= @agent_definition.model_id %></p>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Local tools</dt><dd class="font-mono text-ink"><%= @agent_definition.tool_keys.size %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Provider tools</dt><dd class="font-mono text-ink"><%= @agent_definition.provider_tools.size %></dd></div>
      </dl>
    </div>
    <%= link_to "Edit definition", edit_project_agent_definition_path(@project, @agent_definition), class: "mt-4 inline-flex w-full items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
  </div>
<% end %>

<%= render "shared/shell", active: "agents", project: @project do %>
  <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Agents", project_agent_definitions_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-4 border-b border-line pb-6 sm:flex-row sm:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-3xl font-semibold tracking-tight text-ink"><%= @agent_definition.name %></h1>
          <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">revision <%= @agent_definition.revision %></span>
        </div>
        <p class="mt-2 break-all font-mono text-sm text-muted"><%= @agent_definition.provider %> / <%= @agent_definition.model_id %></p>
      </div>
      <%= link_to "Edit", edit_project_agent_definition_path(@project, @agent_definition), class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
    </div>

    <section class="mt-6 rounded-xl border border-line bg-panel p-5" aria-labelledby="start-agent-run-heading">
      <div>
        <h2 id="start-agent-run-heading" class="text-sm font-semibold text-ink">Run this Agent</h2>
        <p class="mt-1 text-xs leading-5 text-muted">The current definition revision and prompt will be copied into a dedicated Run transcript.</p>
        <% if @agent_definition.tool_keys.any? %>
          <% if @local_tools_model_eligible %>
            <p class="mt-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs leading-5 text-slate-700">RubyLLM's registry declares function calling for this model. This does not verify live provider acceptance.</p>
          <% else %>
            <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-900">This Agent cannot be queued: its model is missing or does not declare function calling in RubyLLM's chat registry. Choose a listed compatible model or remove its local tools.</p>
          <% end %>
        <% end %>
      </div>
      <%= form_with scope: :agent_run, url: project_agent_definition_runs_path(@project, @agent_definition), class: "mt-4" do |form| %>
        <%= form.label :prompt, "Task", class: "text-xs font-medium text-ink" %>
        <%= form.text_area :prompt, required: true, rows: 4, placeholder: "Describe the task this Agent should complete.", class: "mt-2 w-full resize-y rounded-lg border border-line bg-white px-3 py-2.5 text-sm leading-6 outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs text-muted">Provider: <span class="font-mono"><%= @agent_definition.provider %></span></p>
          <%= form.submit "Queue Agent Run", disabled: !@local_tools_model_eligible, class: "inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50" %>
        </div>
      <% end %>
    </section>

    <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)]">
      <section class="rounded-xl border border-line bg-panel p-5" aria-labelledby="agent-instructions-heading">
        <h2 id="agent-instructions-heading" class="text-sm font-semibold text-ink">Instructions</h2>
        <p class="mt-3 whitespace-pre-wrap break-words text-sm leading-6 text-ink"><%= @agent_definition.instructions %></p>
      </section>

      <section class="rounded-xl border border-line bg-panel p-5" aria-labelledby="agent-contract-heading">
        <h2 id="agent-contract-heading" class="text-sm font-semibold text-ink">Tool and generation contract</h2>
        <div class="mt-4">
          <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Local tools</h3>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% @agent_definition.tool_keys.each do |key| %>
              <% definition = @project.tool_definitions.find { |tool| tool.key == key } %>
              <span class="rounded-md bg-accent-soft px-2 py-1 font-mono text-[10px] text-accent"><%= key %><%= definition&.enabled? ? "" : " · unavailable" %></span>
            <% end %>
            <% if @agent_definition.tool_keys.empty? %><span class="text-xs text-muted">None</span><% end %>
          </div>
        </div>
        <div class="mt-5 border-t border-line pt-4">
          <h3 class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Provider tools</h3>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <% @agent_definition.provider_tools.each do |key| %><span class="rounded-md bg-amber-50 px-2 py-1 font-mono text-[10px] text-amber-800"><%= key %></span><% end %>
            <% if @agent_definition.provider_tools.empty? %><span class="text-xs text-muted">None</span><% end %>
          </div>
        </div>
        <dl class="mt-5 divide-y divide-line border-t border-line text-xs">
          <% @agent_definition.options.each do |key, value| %>
            <div class="flex justify-between gap-3 py-3"><dt class="text-muted"><%= key.humanize %></dt><dd class="font-mono text-ink"><%= value %></dd></div>
          <% end %>
          <% if @agent_definition.options.empty? %><div class="py-3 text-muted">No generation overrides</div><% end %>
        </dl>
      </section>
    </div>
  </div>
<% end %>
