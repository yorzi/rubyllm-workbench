<div class="sticky top-0">
  <div class="flex items-center justify-between">
    <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Runtime</p>
    <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success">healthy</span>
  </div>

  <dl class="mt-5 divide-y divide-line rounded-xl border border-line bg-panel text-xs">
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">App</dt>
      <dd class="font-mono text-right text-ink"><%= workbench_app_version %></dd>
    </div>
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">RubyLLM</dt>
      <dd class="font-mono text-right text-ink"><%= ruby_llm_version %></dd>
    </div>
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">Storage</dt>
      <dd class="font-mono text-right text-ink">SQLite</dd>
    </div>
  </dl>

  <div class="mt-5 rounded-xl border border-line bg-canvas p-3 text-xs leading-5 text-muted">
    <p class="font-medium text-ink">Credential boundary</p>
    <p class="mt-1">Provider keys stay in the environment or Rails credentials. They are never rendered here.</p>
  </div>
</div>
