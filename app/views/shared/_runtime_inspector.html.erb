<div class="sticky top-0">
  <div class="flex items-center justify-between">
    <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Runtime</p>
    <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-medium text-muted">Web responding</span>
  </div>

  <dl class="mt-5 divide-y divide-line rounded-xl border border-line bg-panel text-xs">
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">App</dt>
      <dd class="font-mono text-right text-ink"><%= workbench_app_version %></dd>
    </div>
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">RubyLLM</dt>
      <dd class="font-mono text-right text-ink"><%= ruby_llm_version %></dd>
    </div>
    <div class="flex items-start justify-between gap-3 p-3">
      <dt class="text-muted">Storage</dt>
      <dd class="font-mono text-right text-ink">SQLite</dd>
    </div>
  </dl>

  <% if demo_mode? %>
    <section aria-label="Demo execution boundary" class="mt-5 rounded-xl border border-line bg-panel p-3 text-xs leading-5">
      <h2 class="font-medium text-ink">Providers and jobs disabled</h2>
      <p class="mt-2 text-muted">This demo reads an isolated synthetic SQLite snapshot. It cannot run model calls, queue work or save changes.</p>
    </section>
  <% else %>
  <% readiness = queue_readiness %>
  <section aria-label="Background job readiness" class="mt-5 rounded-xl border border-line bg-panel p-3 text-xs leading-5">
    <div class="flex items-center justify-between gap-3">
      <h2 class="font-medium text-ink">Background jobs</h2>
      <span class="rounded-full px-2 py-1 text-[10px] font-medium <%= status_classes(readiness.state) %>"><%= readiness.label %></span>
    </div>
    <p class="mt-2 text-muted"><%= readiness.details %></p>
    <% if readiness.due_agent_deliveries %>
      <dl class="mt-3 divide-y divide-line rounded-lg border border-line text-[11px]">
        <div class="flex justify-between gap-3 p-2">
          <dt class="text-muted">Agent deliveries due</dt>
          <dd class="font-mono text-ink"><%= readiness.due_agent_deliveries %></dd>
        </div>
        <div class="flex justify-between gap-3 p-2">
          <dt class="text-muted">Recurring scheduler</dt>
          <dd class="text-right text-ink"><%= readiness.scheduler_ready ? "Recent heartbeat" : "Not seen" %></dd>
        </div>
        <div class="flex justify-between gap-3 p-2">
          <dt class="text-muted">Queue dispatcher</dt>
          <dd class="text-right text-ink"><%= readiness.dispatcher_ready ? "Recent heartbeat" : "Not seen" %></dd>
        </div>
        <div class="flex justify-between gap-3 p-2">
          <dt class="text-muted">Maintenance worker</dt>
          <dd class="text-right text-ink"><%= readiness.maintenance_worker_ready ? "Recent heartbeat" : "Not seen" %></dd>
        </div>
      </dl>
    <% end %>
  </section>
  <% end %>

  <div class="mt-5 rounded-xl border border-line bg-canvas p-3 text-xs leading-5 text-muted">
    <p class="font-medium text-ink">Credential boundary</p>
    <p class="mt-1"><%= demo_mode? ? "Provider credentials are ignored in demo mode. Run your own local checkout to configure providers and try the workflows." : "Provider keys stay in the environment or Rails credentials. They are never rendered here." %></p>
  </div>
</div>
