<% if notice.present? || alert.present? %>
  <div class="mb-5 space-y-2" aria-live="polite">
    <% if notice.present? %>
      <p class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-success"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700"><%= alert %></p>
    <% end %>
  </div>
<% end %>
