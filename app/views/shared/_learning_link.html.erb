<% topic = local_assigns.fetch(:topic) %>
<% return_to = local_assigns.fetch(:return_to, request.fullpath) %>
<% label = local_assigns.fetch(:label, "How this works") %>

<%= link_to learning_topic_path(topic, return_to: return_to),
      data: { turbo_frame: "learning-panel" },
      aria: { label: "#{label}: #{topic.to_s.tr('_', ' ')}" },
      class: "mt-4 inline-flex w-full items-center justify-between gap-3 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2.5 text-xs font-medium text-accent hover:border-accent hover:bg-indigo-100" do %>
  <span class="flex min-w-0 items-center gap-2"><span aria-hidden="true" class="grid size-5 shrink-0 place-items-center rounded-full bg-white font-mono text-[10px]">?</span><span class="truncate"><%= label %></span></span>
  <span aria-hidden="true" class="font-mono text-[11px]">↗</span>
<% end %>
