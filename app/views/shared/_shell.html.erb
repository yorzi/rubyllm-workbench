<% project = local_assigns[:project] %>
<% active = local_assigns.fetch(:active, nil) %>

<div class="min-h-screen lg:grid lg:grid-cols-[15rem_minmax(0,1fr)_minmax(18rem,26rem)]">
  <aside class="border-b border-line bg-panel px-4 py-5 lg:min-h-screen lg:border-b-0 lg:border-r">
    <div class="flex items-center justify-between gap-3">
      <%= link_to root_path, class: "flex items-center gap-2 text-sm font-semibold tracking-tight text-ink" do %>
        <span class="grid size-8 place-items-center rounded-lg bg-accent text-xs font-bold text-white">RL</span>
        <span>RubyLLM Workbench</span>
      <% end %>
      <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] uppercase tracking-[0.16em] text-muted">local</span>
    </div>

    <nav aria-label="Primary" class="mt-8 space-y-1 text-sm">
      <%= link_to root_path, class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'projects' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}" do %>
        <span>Projects</span>
        <span class="font-mono text-[11px]">P</span>
      <% end %>
      <%= link_to models_path(project_id: project&.slug), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'models' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}" do %>
        <span>Model Explorer</span>
        <span class="font-mono text-[11px]">M</span>
      <% end %>
      <%= link_to(project ? project_experiments_path(project) : root_path(anchor: "new-project"), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'experiments' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}") do %>
        <span>Experiments</span>
        <span class="font-mono text-[11px]">E</span>
      <% end %>
      <%= link_to(project ? project_evaluation_datasets_path(project) : root_path(anchor: "new-project"), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'evaluations' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}") do %>
        <span>Evaluations</span>
        <span class="font-mono text-[11px]">V</span>
      <% end %>
      <%= link_to(project ? project_agent_definitions_path(project) : root_path(anchor: "new-project"), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'agents' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}") do %>
        <span>Agents</span>
        <span class="font-mono text-[11px]">A</span>
      <% end %>
      <%= link_to(project ? project_tool_definitions_path(project) : root_path(anchor: "new-project"), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'tools' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}") do %>
        <span>Tools</span>
        <span class="font-mono text-[11px]">T</span>
      <% end %>
      <%= link_to(project ? project_knowledge_collections_path(project) : root_path(anchor: "new-project"), class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'knowledge' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}") do %>
        <span>Knowledge</span>
        <span class="font-mono text-[11px]">K</span>
      <% end %>
      <%= link_to runs_path, class: "flex items-center justify-between rounded-lg px-3 py-2 #{active == 'runs' ? 'bg-accent-soft font-medium text-accent' : 'text-muted hover:bg-slate-50 hover:text-ink'}" do %>
        <span>Runs</span>
        <span class="font-mono text-[11px]">R</span>
      <% end %>
    </nav>

    <div class="mt-8">
      <div class="mb-2 flex items-center justify-between px-3 text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">
        <span>Projects</span>
        <span><%= @sidebar_projects.size %></span>
      </div>
      <div class="space-y-1">
        <% @sidebar_projects.each do |sidebar_project| %>
          <%= link_to project_path(sidebar_project), class: "block truncate rounded-lg px-3 py-2 text-sm #{project&.id == sidebar_project.id ? 'bg-slate-100 font-medium text-ink' : 'text-muted hover:bg-slate-50 hover:text-ink'}" do %>
            <%= sidebar_project.name %>
          <% end %>
        <% end %>
        <% if @sidebar_projects.empty? %>
          <p class="px-3 text-xs leading-5 text-muted">Create a project to start a durable chat.</p>
        <% end %>
      </div>
    </div>

    <%= link_to root_path(anchor: "new-project"), class: "mt-5 flex items-center justify-center rounded-lg border border-dashed border-line px-3 py-2 text-xs font-medium text-muted hover:border-accent hover:text-accent" do %>
      + New project
    <% end %>

    <div class="mt-10 hidden rounded-xl border border-line bg-canvas p-3 text-xs leading-5 text-muted lg:block">
      <p class="font-medium text-ink">M0–M4 foundation</p>
      <p class="mt-1">Chats, tools, approvals, experiments, local knowledge, and inspectable evidence.</p>
    </div>
  </aside>

  <main class="min-w-0 bg-canvas">
    <%= yield %>
  </main>

  <aside class="border-t border-line bg-panel px-4 py-5 lg:min-h-screen lg:border-l lg:border-t-0">
    <turbo-frame id="learning-panel">
      <%= content_for?(:inspector) ? yield(:inspector) : render("shared/runtime_inspector") %>
    </turbo-frame>
  </aside>
</div>
