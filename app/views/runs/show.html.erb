<% tool_options = @run.input_snapshot.fetch("tool_options", {}) %>
<% content_for :title, "Run ##{@run.id} · RubyLLM Workbench" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Run inspector</p>
      <%= render "runs/status", run: @run %>
    </div>
    <%= render "shared/learning_link", topic: "run_inspector", label: "How the inspector works" %>
    <%= render "shared/learning_link", topic: "chat_run", label: "How the Chat Run works" %>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <dl class="divide-y divide-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Project</dt><dd class="max-w-[10rem] truncate text-right text-ink"><%= @run.project.name %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Operation</dt><dd class="font-mono text-ink"><%= @run.operation %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Requested by</dt><dd class="font-mono text-ink"><%= @run.requested_by %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">App</dt><dd class="font-mono text-ink"><%= @run.app_version %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">RubyLLM</dt><dd class="font-mono text-ink"><%= @run.ruby_llm_version %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Tool execution</dt><dd class="font-mono text-right text-ink"><%= tool_options.fetch("effective_mode", "sequential") %></dd></div>
      </dl>
      <% if tool_options["fallback_reason"].present? %><p class="mt-3 border-t border-line pt-3 text-[11px] leading-5 text-muted">Parallel request fell back: <span class="font-mono text-ink"><%= tool_options["fallback_reason"] %></span></p><% end %>
    </div>
  </div>
<% end %>

<%= render "shared/shell", active: "projects", project: @run.project do %>
  <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← #{@run.project.name}", project_path(@run.project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-end">
      <div>
        <div class="flex items-center gap-3"><h1 class="font-mono text-2xl font-semibold tracking-tight text-ink">Run #<%= @run.id %></h1><%= render "runs/status", run: @run %></div>
        <% primary_attempt = @run.attempts.first %>
        <p class="mt-2 break-all font-mono text-xs text-muted"><%= primary_attempt&.provider || @run.chat.provider %> / <%= primary_attempt&.model_id || @run.chat.model_id %> · <%= @run.operation %></p>
        <% if @run.experiment? %><p class="mt-2 text-xs text-muted">Experiment: <%= link_to @run.experiment.name, project_experiment_path(@run.project, @run.experiment), class: "font-medium text-accent hover:underline" %> · revision <%= @run.input_snapshot.dig("experiment", "revision") || @run.experiment.revision %></p><% end %>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Download events JSON", events_run_path(@run), data: { turbo_confirm: "This export contains sanitized event metadata, limited to the latest 100 events. Review it before sharing." }, class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
        <%= link_to "Download reproduction JSON", reproduction_run_path(@run), data: { turbo_confirm: "This export contains the Chat history and Run messages plus sanitized execution context. Review it before sharing." }, class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
        <% if %w[agent image speech transcription video].include?(@run.operation) && !@run.terminal? %>
          <%= button_to "Cancel Run", cancel_run_path(@run), method: :post, form: { data: { turbo_confirm: "Cancel this Run? The provider may already have accepted the request." } }, class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-rose-200 px-3 py-2 text-xs font-medium text-rose-700 hover:bg-rose-50" %>
        <% end %>
        <%= link_to "Return to chat", project_chat_path(@run.project, @run.chat), class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" if @run.chat %>
      </div>
    </div>

    <% if @run.app_version == "demo" && @run.input_snapshot["demo_note"].present? %>
      <p class="mt-5 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-800"><%= @run.input_snapshot["demo_note"] %> The values below are illustrative.</p>
    <% end %>

    <section class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="Run metrics">
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Duration</p><p class="mt-2 font-mono text-lg font-semibold text-ink"><%= format_duration(@run.duration_ms) %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">First output</p><p class="mt-2 font-mono text-lg font-semibold text-ink"><%= format_duration(@run.time_to_first_output_ms) %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Input / output</p><p class="mt-2 font-mono text-lg font-semibold text-ink"><%= format_tokens(@run.total_tokens[:input]) %> / <%= format_tokens(@run.total_tokens[:output]) %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Cost</p><p class="mt-2 text-sm font-semibold text-ink"><%= format_cost(@run.total_cost, status: @run.cost_status) %></p></div>
    </section>

    <% if @run.error_summary.present? %>
      <section class="mt-6 rounded-xl border border-rose-200 bg-rose-50 p-4" aria-labelledby="diagnostic-heading">
        <h2 id="diagnostic-heading" class="text-sm font-semibold text-rose-700">Diagnostic</h2>
        <p class="mt-2 whitespace-pre-wrap break-words text-sm leading-6 text-rose-700"><%= @run.error_summary %></p>
        <% if @run.result_summary["failure_kind"].present? %><p class="mt-2 font-mono text-[11px] text-rose-700">failure_kind: <%= @run.result_summary["failure_kind"] %></p><% end %>
      </section>
    <% end %>

    <% if @agent_research_report %>
      <% research_report = @agent_research_report.content_json %>
      <section id="agent-research-report" class="mt-8 rounded-xl border border-line bg-panel p-5" aria-labelledby="agent-research-report-heading">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
          <div>
            <h2 id="agent-research-report-heading" class="text-sm font-semibold text-ink">Agent research report</h2>
            <p class="mt-1 text-xs text-muted"><%= research_report.dig("agent", "name") %> · revision <%= research_report.dig("agent", "revision") %> · <%= research_report["provider"] %> / <%= research_report["model_id"] %></p>
          </div>
          <span class="font-mono text-[10px] text-muted">Artifact #<%= @agent_research_report.id %></span>
        </div>
        <div class="mt-4 whitespace-pre-wrap break-words text-sm leading-6 text-ink"><%= @agent_research_report.content_text %></div>
        <% if @agent_research_citations.any? %>
          <div class="mt-4 border-t border-line pt-3">
            <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-muted">Sources attached to this report</p>
            <ul class="mt-2 flex flex-wrap gap-2">
              <% @agent_research_citations.each do |citation_artifact| %>
                <li><%= link_to "Attempt #{citation_artifact.attempt&.sequence || '—'} · #{Array(citation_artifact.parsed_content).size} sources", "#citation-artifact-#{citation_artifact.id}", class: "inline-flex rounded-lg border border-line px-3 py-2 text-xs font-medium text-accent hover:border-accent" %></li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </section>
    <% end %>

    <section id="upstream-candidates" class="mt-8 rounded-xl border border-line bg-panel p-5" aria-labelledby="upstream-candidates-heading">
      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
        <div>
          <h2 id="upstream-candidates-heading" class="text-sm font-semibold text-ink">Upstream gap report<%= render "shared/experimental_badge", reason: "Experimental: drafts are generated locally and always need a manual privacy review before sharing." %></h2>
          <p class="mt-1 max-w-3xl text-xs leading-5 text-muted">Record a reviewed hypothesis from this Run. Each report is saved as a new Artifact. The Markdown draft includes a redacted reproduction export and still needs human review before sharing.</p>
        </div>
      </div>

      <% if @upstream_candidates.any? %>
        <div class="mt-4 space-y-2">
          <% @upstream_candidates.each do |candidate| %>
            <article class="flex flex-col justify-between gap-3 rounded-lg border border-line bg-canvas p-3 sm:flex-row sm:items-center">
              <div class="min-w-0">
                <p class="break-words text-xs font-medium text-ink"><%= candidate.content_json["title"] %></p>
                <p class="mt-1 font-mono text-[10px] text-muted"><%= candidate.metadata_json["category"] %> · <%= candidate.created_at.utc.strftime("%Y-%m-%d %H:%M UTC") %> · Artifact #<%= candidate.id %></p>
              </div>
              <%= link_to "Download issue draft", upstream_issue_draft_run_path(@run, artifact_id: candidate.id), class: "inline-flex w-fit items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
            </article>
          <% end %>
        </div>
      <% end %>

      <%= form_with url: upstream_candidates_run_path(@run), scope: :upstream_candidate, class: "mt-5 grid gap-4 sm:grid-cols-2" do |form| %>
        <div>
          <%= form.label :category, "Classification", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.select :category, options_for_select([["Application bug", "app_bug"], ["RubyLLM gap", "ruby_llm_gap"], ["Provider limitation", "provider_limitation"], ["Unconfirmed", "unconfirmed"]], "unconfirmed"), {}, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs text-ink" %>
        </div>
        <div>
          <%= form.label :title, "Issue title", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.text_field :title, required: true, maxlength: 200, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs text-ink" %>
        </div>
        <div>
          <%= form.label :expected_behavior, "Expected behavior", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.text_area :expected_behavior, required: true, rows: 3, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs leading-5 text-ink" %>
        </div>
        <div>
          <%= form.label :observed_behavior, "Observed behavior", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.text_area :observed_behavior, required: true, rows: 3, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs leading-5 text-ink" %>
        </div>
        <div>
          <%= form.label :reproduction_steps, "Minimal reproduction steps", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.text_area :reproduction_steps, required: true, rows: 4, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs leading-5 text-ink" %>
        </div>
        <div>
          <%= form.label :regression_test_reference, "Regression test reference (optional)", class: "mb-1 block text-xs font-medium text-ink" %>
          <%= form.text_area :regression_test_reference, rows: 4, maxlength: 500, class: "w-full rounded-lg border border-line bg-canvas px-3 py-2 text-xs leading-5 text-ink" %>
        </div>
        <div class="sm:col-span-2">
          <%= form.submit "Save candidate report", class: "cursor-pointer rounded-lg bg-accent px-4 py-2.5 text-xs font-medium text-white hover:bg-indigo-700" %>
        </div>
      <% end %>
    </section>

    <section class="mt-8" aria-labelledby="attempts-heading">
      <div class="flex items-center justify-between gap-3"><h2 id="attempts-heading" class="text-sm font-semibold text-ink">Attempts</h2><span class="font-mono text-xs text-muted"><%= @run.attempts.size %> recorded</span></div>
      <div class="mt-3 overflow-x-auto rounded-xl border border-line bg-panel">
        <table class="min-w-full text-left text-xs">
          <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted">
            <tr><th class="px-4 py-3 font-semibold">#</th><th class="px-4 py-3 font-semibold">Provider / model</th><th class="px-4 py-3 font-semibold">Status</th><th class="px-4 py-3 font-semibold">Tokens</th><th class="px-4 py-3 font-semibold">Cost</th><th class="px-4 py-3 font-semibold">Duration</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @run.attempts.each do |attempt| %>
              <tr>
                <td class="px-4 py-3 font-mono text-muted"><%= attempt.sequence %></td>
                <td class="px-4 py-3"><span class="block font-medium text-ink"><%= attempt.provider %></span><span class="mt-1 block max-w-[18rem] truncate font-mono text-muted"><%= attempt.model_id %></span></td>
                <td class="px-4 py-3"><span class="inline-flex rounded-full px-2 py-1 text-[11px] font-medium <%= status_classes(attempt.status) %>"><%= attempt.status.to_s.capitalize %></span></td>
                <td class="whitespace-nowrap px-4 py-3 font-mono text-muted"><%= format_tokens(attempt.input_tokens) %> / <%= format_tokens(attempt.output_tokens) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= format_cost(attempt.cost, status: attempt.cost_status) %></td>
                <td class="whitespace-nowrap px-4 py-3 text-muted"><%= format_duration(attempt.duration_ms) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-8" aria-labelledby="lifecycle-events-heading">
      <div class="flex items-center justify-between gap-3"><h2 id="lifecycle-events-heading" class="text-sm font-semibold text-ink">Lifecycle events</h2><span class="font-mono text-xs text-muted"><%= @lifecycle_events.size %> recorded</span></div>
      <% if @lifecycle_events.empty? %>
        <div class="mt-3 rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted">No lifecycle events were recorded for this Run.</div>
      <% else %>
        <ol class="mt-3 overflow-hidden rounded-xl border border-line bg-panel divide-y divide-line">
          <% @lifecycle_events.each do |event| %>
            <li class="flex min-w-0 flex-col gap-1 px-4 py-3 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
              <div class="min-w-0">
                <p class="break-all font-mono text-[11px] font-medium text-ink"><%= event.name %></p>
                <p class="mt-1 break-words text-xs text-muted"><%= lifecycle_event_summary(event) %></p>
              </div>
              <time class="shrink-0 font-mono text-[10px] text-muted" datetime="<%= event.occurred_at.iso8601 %>"><%= l(event.occurred_at, format: :short) %></time>
            </li>
          <% end %>
        </ol>
      <% end %>
    </section>

    <section class="mt-8" aria-labelledby="tools-heading">
      <div class="flex items-center justify-between gap-3"><h2 id="tools-heading" class="text-sm font-semibold text-ink">Tools</h2><span class="font-mono text-xs text-muted"><%= @tool_invocations.size %> recorded</span></div>
      <div class="mt-3 space-y-3">
        <% if @tool_invocations.empty? %>
          <div class="rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted">No tool calls recorded for this Run.</div>
        <% else %>
          <% @tool_invocations.each do |invocation| %>
            <article class="rounded-xl border border-line bg-panel p-4">
              <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                <div><h3 class="text-sm font-semibold text-ink"><%= invocation.display_name %></h3><p class="mt-1 font-mono text-[10px] text-muted"><%= invocation.tool_key %> · <%= invocation.tool_call_id %></p><% if invocation.remote? %><p class="mt-1 inline-flex rounded-full bg-amber-50 px-2 py-0.5 text-[10px] font-medium text-amber-800">provider-executed · remote</p><% end %></div>
                <span class="inline-flex w-fit rounded-full px-2 py-1 text-[10px] font-medium <%= status_classes(invocation.status) %>"><%= invocation.status.to_s.humanize %></span>
              </div>
              <div class="mt-4 grid min-w-0 gap-4 lg:grid-cols-2">
                <div class="min-w-0"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-muted">Arguments</p><pre class="mt-2 max-h-40 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-3 font-mono text-[11px] leading-5 text-muted"><%= JSON.pretty_generate(invocation.arguments) %></pre></div>
                <div class="min-w-0"><p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-muted">Result</p><% if invocation.result.present? %><pre class="mt-2 max-h-40 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-3 font-mono text-[11px] leading-5 text-muted"><%= JSON.pretty_generate(invocation.result) %></pre><% else %><p class="mt-2 rounded-lg bg-canvas p-3 text-xs text-muted">No result yet.</p><% end %></div>
              </div>
              <dl class="mt-4 flex flex-wrap gap-x-5 gap-y-2 border-t border-line pt-3 text-[11px] text-muted"><div><dt class="inline">Approval: </dt><dd class="inline font-medium text-ink"><%= invocation.approval&.status || "not required" %></dd></div><div><dt class="inline">Duration: </dt><dd class="inline font-mono text-ink"><%= format_duration(invocation.duration_ms) %></dd></div><% if invocation.error_message.present? %><div class="basis-full"><dt class="inline">Diagnostic: </dt><dd class="inline break-words text-rose-700"><% if invocation.error_code.present? %><code class="font-mono"><%= invocation.error_code %></code> · <% end %><%= invocation.error_message %></dd></div><% end %></dl>
              <% if invocation.approval_pending? %><%= link_to "Review in chat", project_chat_path(@run.project, @run.chat, anchor: "tool-approvals"), class: "mt-3 inline-flex text-xs font-medium text-accent hover:underline" %><% end %>
            </article>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="mt-8 grid gap-6 xl:grid-cols-2">
      <div class="rounded-xl border border-line bg-panel p-5">
        <h2 class="text-sm font-semibold text-ink">Input snapshot</h2>
        <pre class="mt-4 max-h-72 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-4 font-mono text-xs leading-5 text-muted"><%= JSON.pretty_generate(@run.input_snapshot) %></pre>
      </div>
      <div class="rounded-xl border border-line bg-panel p-5">
        <h2 class="text-sm font-semibold text-ink">Result</h2>
        <% if @structured_artifact %>
          <div class="mt-4 flex items-center justify-between gap-3"><span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success">JSON artifact · valid</span><span class="font-mono text-[10px] text-muted"><%= @structured_artifact.name %></span></div>
          <pre class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-4 font-mono text-xs leading-5 text-ink"><%= JSON.pretty_generate(@structured_artifact.parsed_content) %></pre>
        <% elsif @transcript_artifacts.any? %>
          <% transcript = @transcript_artifacts.first %>
          <div class="mt-4 flex items-center justify-between gap-3"><span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success">Transcript Artifact</span><span class="font-mono text-[10px] text-muted"><%= transcript.metadata_json["provider"] %> / <%= transcript.metadata_json["model_id"] %></span></div>
          <% if transcript.content_text.present? %>
            <div class="mt-3 max-h-96 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-4 text-sm leading-6 text-ink"><%= transcript.content_text %></div>
          <% else %>
            <p class="mt-3 rounded-lg bg-canvas p-4 text-sm text-muted">The transcription completed without detecting spoken words.</p>
          <% end %>
        <% elsif @video_artifacts.any? %>
          <p class="mt-4 rounded-lg bg-canvas p-4 text-sm text-muted">Video generation completed. Preview and download the video Artifact below.</p>
        <% else %>
          <% result_text = @source_assistant_message&.content.presence || @run.result_summary["partial_output"] %>
          <% if result_text.present? %>
            <div class="mt-4 whitespace-pre-wrap break-words rounded-lg bg-canvas p-4 text-sm leading-6 text-ink"><%= result_text %></div>
          <% else %>
            <p class="mt-4 rounded-lg bg-canvas p-4 text-sm text-muted">No durable output recorded yet.</p>
          <% end %>
        <% end %>
      </div>
    </section>

    <% audio_artifacts = @run.artifacts.select { |artifact| artifact.kind == "audio" && artifact.audio_file.attached? } %>
    <% if audio_artifacts.any? %>
      <section class="mt-8" aria-labelledby="audio-artifacts-heading">
        <h2 id="audio-artifacts-heading" class="text-sm font-semibold text-ink">Audio Artifacts</h2>
        <div class="mt-3 space-y-3">
          <% audio_artifacts.each do |artifact| %>
            <article class="rounded-xl border border-line bg-panel p-4">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <h3 class="text-sm font-medium text-ink"><%= artifact.name %></h3>
                  <p class="mt-1 break-all font-mono text-[10px] text-muted"><%= artifact.metadata_json["provider"] %> / <%= artifact.metadata_json["model_id"] %> · <%= artifact.metadata_json["mime_type"] %> · <%= number_to_human_size(artifact.metadata_json["byte_size"]) %></p>
                </div>
                <%= link_to "Download", rails_blob_path(artifact.audio_file, disposition: "attachment"), class: "rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
              </div>
              <audio class="mt-4 w-full" controls preload="none" src="<%= rails_blob_path(artifact.audio_file, disposition: "inline") %>">Your browser does not support embedded audio playback.</audio>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @image_artifacts.any? %>
      <section class="mt-8" aria-labelledby="image-artifacts-heading">
        <h2 id="image-artifacts-heading" class="text-sm font-semibold text-ink">Image Artifacts</h2>
        <div class="mt-3 grid gap-4 sm:grid-cols-2">
          <% @image_artifacts.each do |artifact| %>
            <article class="overflow-hidden rounded-xl border border-line bg-panel">
              <%= image_tag rails_blob_path(artifact.media_file, disposition: "inline"), alt: "Generated image for Run ##{@run.id}", loading: "lazy", class: "max-h-[32rem] w-full bg-canvas object-contain" %>
              <div class="flex flex-wrap items-center justify-between gap-3 p-4">
                <div>
                  <h3 class="text-sm font-medium text-ink"><%= artifact.name %></h3>
                  <p class="mt-1 break-all font-mono text-[10px] text-muted"><%= artifact.metadata_json["provider"] %> / <%= artifact.metadata_json["model_id"] %> · <%= artifact.metadata_json["mime_type"] %> · <%= number_to_human_size(artifact.metadata_json["byte_size"]) %></p>
                </div>
                <%= link_to "Download", rails_blob_path(artifact.media_file, disposition: "attachment"), class: "rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
              </div>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @video_artifacts.any? %>
      <section class="mt-8" aria-labelledby="video-artifacts-heading">
        <h2 id="video-artifacts-heading" class="text-sm font-semibold text-ink">Video Artifacts</h2>
        <div class="mt-3 space-y-4">
          <% @video_artifacts.each do |artifact| %>
            <article class="overflow-hidden rounded-xl border border-line bg-panel">
              <video class="max-h-[36rem] w-full bg-black" controls preload="metadata" src="<%= rails_blob_path(artifact.media_file, disposition: "inline") %>">Your browser does not support embedded video playback.</video>
              <div class="flex flex-wrap items-center justify-between gap-3 p-4">
                <div>
                  <h3 class="text-sm font-medium text-ink"><%= artifact.name %></h3>
                  <p class="mt-1 break-all font-mono text-[10px] text-muted"><%= artifact.metadata_json["provider"] %> / <%= artifact.metadata_json["model_id"] %> · <%= artifact.metadata_json["mime_type"] %> · <%= number_to_human_size(artifact.metadata_json["byte_size"]) %><% if artifact.metadata_json["duration_seconds"] %> · <%= artifact.metadata_json["duration_seconds"] %> sec<% end %></p>
                </div>
                <%= link_to "Download", rails_blob_path(artifact.media_file, disposition: "attachment"), class: "rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
              </div>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @transcript_artifacts.any? %>
      <section class="mt-8" aria-labelledby="transcript-artifacts-heading">
        <h2 id="transcript-artifacts-heading" class="text-sm font-semibold text-ink">Transcript Artifacts</h2>
        <div class="mt-3 space-y-3">
          <% @transcript_artifacts.each do |artifact| %>
            <article class="rounded-xl border border-line bg-panel p-4">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h3 class="text-sm font-medium text-ink"><%= artifact.name %></h3>
                <p class="font-mono text-[10px] text-muted"><%= artifact.metadata_json["provider"] %> / <%= artifact.metadata_json["model_id"] %> · <%= artifact.metadata_json["language"].presence || "language not reported" %></p>
              </div>
              <p class="mt-1 text-[10px] text-muted">Source audio SHA-256: <span class="font-mono"><%= artifact.metadata_json["source_sha256"] %></span></p>
              <% if artifact.content_text.present? %>
                <div class="mt-3 max-h-72 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-canvas p-4 text-sm leading-6 text-ink"><%= artifact.content_text %></div>
              <% else %>
                <p class="mt-3 rounded-lg bg-canvas p-4 text-sm text-muted">No spoken words were detected.</p>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <% provider_tool_calls = Array(@run.result_summary["provider_tool_calls"]) %>
    <% provider_tool_usage = @run.result_summary["provider_tool_usage"].to_h %>
    <% if provider_tool_calls.any? || provider_tool_usage.any? %>
      <section class="mt-8 rounded-xl border border-line bg-panel p-5" aria-label="Provider tool activity">
        <h2 class="text-sm font-semibold text-ink">Provider tool activity</h2>
        <% if provider_tool_usage.any? %>
          <dl id="provider-tool-usage" class="mt-3 flex flex-wrap gap-2 text-xs">
            <% provider_tool_usage.each do |counter, count| %>
              <div class="rounded-md bg-canvas px-2 py-1"><dt class="inline text-muted"><%= counter.to_s.tr("_", " ") %></dt> <dd class="inline font-mono text-ink"><%= count %></dd></div>
            <% end %>
          </dl>
          <p class="mt-2 text-xs leading-5 text-muted">Provider-reported usage counters. Some providers run hosted tools without returning individual call records.</p>
        <% end %>
        <%= render "messages/provider_tool_activity", calls: provider_tool_calls %>
      </section>
    <% end %>

    <% if @citation_artifacts.any? %>
      <section class="mt-8" aria-labelledby="citations-heading">
        <div class="flex items-center justify-between gap-3"><h2 id="citations-heading" class="text-sm font-semibold text-ink">Source citations</h2><span class="font-mono text-xs text-muted"><%= @citation_artifacts.sum { |artifact| Array(artifact.parsed_content).size } %> recorded</span></div>
        <div class="mt-3 space-y-3">
          <% @citation_artifacts.each do |artifact| %>
            <article id="citation-artifact-<%= artifact.id %>" class="rounded-xl border border-line bg-panel p-4">
              <p class="mb-3 font-mono text-[10px] text-muted"><%= artifact.name %> · Attempt <%= artifact.attempt&.sequence || "—" %></p>
              <ul class="space-y-2 text-xs">
                <% Array(artifact.parsed_content).each do |citation| %>
                  <% url = citation_link_url(citation) %>
                  <% title = citation_value(citation, :title).presence || url || "Source" %>
                  <li class="break-words">
                    <% if url %><%= link_to title, url, target: "_blank", rel: "noopener noreferrer", class: "font-medium text-accent underline decoration-accent/30 underline-offset-2 hover:decoration-accent" %><% else %><span class="text-muted"><%= title %></span><% end %>
                    <% cited_text = citation_value(citation, :cited_text) %>
                    <% if cited_text.present? %><p class="mt-1 whitespace-pre-wrap text-muted"><%= cited_text %></p><% end %>
                  </li>
                <% end %>
              </ul>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
