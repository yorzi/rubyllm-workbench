<article class="rounded-xl border border-line bg-panel p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <%= link_to "Run ##{run.id}", run_path(run), class: "font-mono text-xs font-medium text-accent hover:underline" %>
      <%= render "runs/status", run: run %>
    </div>
    <time class="text-xs text-muted" datetime="<%= run.created_at.iso8601 %>"><%= time_ago_in_words(run.created_at) %> ago</time>
  </div>
  <div class="mt-3 grid gap-3 text-xs text-muted sm:grid-cols-3">
    <div><span class="block text-[10px] uppercase tracking-[0.12em]">Model</span><span class="mt-1 block font-mono text-ink"><%= run.chat.provider %> / <%= run.chat.model_id %></span></div>
    <div><span class="block text-[10px] uppercase tracking-[0.12em]">Duration</span><span class="mt-1 block text-ink"><%= format_duration(run.duration_ms) %></span></div>
    <div><span class="block text-[10px] uppercase tracking-[0.12em]">Cost</span><span class="mt-1 block text-ink"><%= format_cost(run.total_cost, status: run.cost_status) %></span></div>
  </div>
</article>
