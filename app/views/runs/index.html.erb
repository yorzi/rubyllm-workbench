<% content_for :title, "Runs · RubyLLM Workbench" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Run history</p>
      <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success">local</span>
    </div>
    <%= render "shared/learning_link", topic: "run_inspector" %>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <p class="text-sm font-semibold text-ink">Every execution stays inspectable.</p>
      <p class="mt-2 text-xs leading-5 text-muted">Filter the local Run ledger, then open a stable detail page for timing, usage, cost provenance, attempts, and diagnostics.</p>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Matches</dt><dd class="font-mono text-ink"><%= number_with_delimiter(@total_count) %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Shown</dt><dd class="font-mono text-ink"><%= number_with_delimiter(@runs.size) %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">History cap</dt><dd class="font-mono text-ink">100</dd></div>
      </dl>
    </div>
  </div>
<% end %>

<%= render "shared/shell", active: "runs" do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Global ledger</p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">Runs</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">A searchable history of local AI executions across projects. Failed work remains visible with its diagnostic context.</p>
      </div>
      <%= link_to "Browse models", models_path, class: "inline-flex items-center justify-center rounded-lg border border-line px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent" %>
    </div>

    <%= form_with url: runs_path, method: :get, local: true, class: "mt-8 rounded-xl border border-line bg-panel p-4" do %>
      <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_10rem_12rem_auto] md:items-end">
        <div>
          <%= label_tag :q, "Search", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
          <%= text_field_tag :q, @query, placeholder: "Project, model, provider or Run ID", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm text-ink outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div>
          <%= label_tag :status, "Status", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
          <%= select_tag :status, options_for_select([["All statuses", ""]] + @status_options.map { |status| [ status.tr("_", " ").capitalize, status ] }, @status), class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm text-ink outline-none focus:border-accent focus:ring-4 focus:ring-accent/20" %>
        </div>
        <div>
          <%= label_tag :provider, "Provider", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
          <%= select_tag :provider, options_for_select([["All providers", ""]] + @provider_options.map { |provider| [ provider, provider ] }, @provider), class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm text-ink outline-none focus:border-accent focus:ring-4 focus:ring-accent/20" %>
        </div>
        <div class="flex gap-2">
          <%= submit_tag "Filter", class: "w-full rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white hover:bg-indigo-700" %>
          <% if @query.present? || @status || @provider %>
            <%= link_to "Clear", runs_path, class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2.5 text-sm font-medium text-muted hover:border-accent hover:text-accent" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-8 flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-ink"><%= number_with_delimiter(@total_count) %> matching <%= "run".pluralize(@total_count) %></h2>
      <% if @total_count > @runs.size %><span class="text-xs text-muted">Showing the latest 100</span><% end %>
    </div>

    <div class="mt-3 space-y-3">
      <% @runs.each do |run| %>
        <%= render "runs/row", run: run %>
      <% end %>
      <% if @runs.empty? %>
        <div class="rounded-xl border border-dashed border-line bg-panel p-8 text-center">
          <% if @query.present? || @status || @provider %>
            <p class="text-sm font-medium text-ink">No runs match these filters.</p>
            <p class="mt-2 text-sm leading-5 text-muted">Clear the filters or submit another project chat to create a new Run.</p>
            <%= link_to "Clear filters", runs_path, class: "mt-4 inline-flex rounded-lg border border-line px-3 py-2 text-xs font-medium text-accent hover:border-accent" %>
          <% else %>
            <p class="text-sm font-medium text-ink">No Runs yet.</p>
            <p class="mt-2 text-sm leading-5 text-muted">Choose a configured model, submit a chat message, and its lifecycle will appear here.</p>
            <%= link_to "Browse models", models_path, class: "mt-4 inline-flex rounded-lg bg-accent px-3 py-2 text-xs font-medium text-white hover:bg-indigo-700" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
