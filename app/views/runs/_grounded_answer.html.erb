<% snapshot = run.input_snapshot.fetch("grounded_answer") %>
<% artifact = run.artifacts.find { |item| item.metadata_json["report_type"] == "grounded_answer" } %>
<section class="mt-8 rounded-xl border border-line bg-panel p-5" aria-labelledby="grounded-answer-heading">
  <h2 id="grounded-answer-heading" class="text-sm font-semibold text-ink">Answer with sources</h2>
  <%= render "shared/learning_link", topic: "grounded_answer", label: "How source answers work" %>
  <%= link_to "Return to sources", project_knowledge_collection_path(run.project, snapshot.fetch("collection_id")), class: "mt-2 inline-block text-xs text-accent hover:underline" %>
  <p class="mt-2 whitespace-pre-wrap break-words text-sm text-ink"><%= snapshot.fetch("question") %></p>
  <p class="mt-2 text-xs leading-5 text-muted">Lexical retrieval · frozen evidence · exact quotes checked. Citation validity does not verify whether a claim is correct. Source instructions are untrusted data.</p>
  <% if artifact %>
    <% answer = artifact.content_json %>
    <% if answer["status"] == "insufficient_evidence" %>
      <div class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
        <p class="font-medium">Insufficient evidence</p>
        <p class="mt-1 whitespace-pre-wrap break-words"><%= answer["reason"] %></p>
      </div>
    <% else %>
      <ol class="mt-4 list-decimal space-y-4 pl-5 text-sm text-ink">
        <% answer.fetch("claims").each do |claim| %>
          <li class="break-words">
            <p class="whitespace-pre-wrap"><%= claim["text"] %></p>
            <% claim.fetch("citations").each do |citation| %>
              <blockquote class="mt-2 border-l-2 border-line pl-3 text-xs leading-5 text-muted">
                <%= link_to citation["evidence_id"], "#grounded-evidence-#{citation['evidence_id']}", class: "font-mono text-accent hover:underline" %>
                <span class="whitespace-pre-wrap"><%= citation["quote"] %></span>
              </blockquote>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  <% else %>
    <p class="mt-4 text-xs text-muted"><%= run.terminal? ? "No validated answer was saved. See the Run diagnostic." : "Answer queued or running. Refresh this page to check its status." %></p>
  <% end %>
  <details class="mt-5 border-t border-line pt-3" open>
    <summary class="cursor-pointer text-xs font-medium text-ink">Frozen evidence (<%= snapshot.fetch("evidence").size %> chunks)</summary>
    <p class="mt-2 break-all font-mono text-[10px] text-muted">Corpus SHA-256: <%= snapshot.fetch("corpus_checksum") %></p>
    <% snapshot.fetch("evidence").each do |evidence| %>
      <article id="grounded-evidence-<%= evidence['evidence_id'] %>" class="mt-3 rounded-lg border border-line bg-canvas p-3">
        <p class="break-words text-xs font-medium text-ink"><%= evidence["evidence_id"] %> · <%= evidence["title"] %></p>
        <p class="mt-1 break-all font-mono text-[10px] text-muted"><%= evidence["source_reference"].presence || "No source reference" %> · chunk #<%= evidence["chunk_id"] %> · lines <%= evidence["line_start"] %>–<%= evidence["line_end"] %> · chars <%= evidence["char_start"] %>–<%= evidence["char_end"] %> (end exclusive)</p>
        <p class="mt-1 break-all font-mono text-[10px] text-muted">Chunk SHA-256: <%= evidence["chunk_checksum"] %></p>
        <pre class="mt-2 max-h-64 overflow-auto whitespace-pre-wrap break-words font-mono text-xs leading-5 text-muted"><%= evidence["text"] %></pre>
      </article>
    <% end %>
  </details>
</section>
