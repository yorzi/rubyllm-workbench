<% content_for :title, "Model Explorer · RubyLLM Workbench" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Catalog inspector</p>
      <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted"><%= @model_count %></span>
    </div>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4 text-xs leading-5">
      <p class="font-medium text-ink">Provider state is explicit</p>
      <p class="mt-2 text-muted">A model can be browsed from the bundled RubyLLM registry before its provider credentials are configured.</p>
      <div class="mt-4 space-y-2 border-t border-line pt-3">
        <div class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-500"></span><span class="text-muted">Configured — runnable</span></div>
        <div class="flex items-center gap-2"><span class="size-2 rounded-full bg-amber-500"></span><span class="text-muted">Needs configuration — browse only</span></div>
      </div>
    </div>
    <% if @selected_project %>
      <div class="mt-4 rounded-xl border border-line bg-canvas p-4 text-xs">
        <p class="font-medium text-ink">Current project</p>
        <p class="mt-1 font-mono text-muted">/<%= @selected_project.slug %></p>
        <%= link_to "Open project", project_path(@selected_project), class: "mt-3 inline-flex text-accent hover:underline" %>
      </div>
    <% else %>
      <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-warning">Create a project before starting a chat. The catalog itself remains available.</div>
    <% end %>
  </div>
<% end %>

<%= render "shared/shell", active: "models", project: @selected_project do %>
  <div class="mx-auto max-w-7xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">RubyLLM registry</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Model Explorer</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">Compare chat-capable models by provider, capability, context, pricing, and local configuration state.</p>
      </div>
      <% if @selected_project %>
        <%= link_to "New chat in #{@selected_project.name}", new_project_chat_path(@selected_project), class: "inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
      <% else %>
        <%= link_to "Create a project", root_path(anchor: "new-project"), class: "inline-flex items-center justify-center rounded-lg bg-ink px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-700" %>
      <% end %>
    </div>

    <%= form_with url: models_path, method: :get, scope: nil, class: "mt-8 rounded-2xl border border-line bg-panel p-4 shadow-sm" do %>
      <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_12rem_12rem_10rem_auto] lg:items-end">
        <div>
          <%= label_tag :q, "Search", class: "text-xs font-medium text-ink" %>
          <%= text_field_tag :q, params[:q], placeholder: "Search model, provider, or family", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div>
          <%= label_tag :provider, "Provider", class: "text-xs font-medium text-ink" %>
          <%= select_tag :provider, options_for_select([["All providers", ""]] + @providers.map { |slug, name| [name, slug] }, params[:provider]), class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm focus:border-accent focus:outline-none" %>
        </div>
        <div>
          <%= label_tag :capability, "Capability", class: "text-xs font-medium text-ink" %>
          <%= select_tag :capability, options_for_select([["All capabilities", ""]] + Ai::ModelCatalog::FILTERABLE_CAPABILITIES.map { |capability| [capability_label(capability), capability] }, params[:capability]), class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm focus:border-accent focus:outline-none" %>
        </div>
        <div>
          <%= label_tag :configured, "State", class: "text-xs font-medium text-ink" %>
          <%= select_tag :configured, options_for_select([["Any state", ""], ["Configured", "true"], ["Needs setup", "false"]], params[:configured]), class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm focus:border-accent focus:outline-none" %>
        </div>
        <%= submit_tag "Filter", class: "cursor-pointer rounded-lg border border-line bg-canvas px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent" %>
      </div>
    <% end %>

    <div class="mt-8 flex items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-ink">Chat models</h2>
      <p class="font-mono text-xs text-muted"><%= @model_count %> matches<%= @model_count > @models.size ? " · showing first #{@models.size}" : "" %></p>
    </div>

    <div class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @models.each do |entry| %>
        <article class="flex min-w-0 flex-col rounded-2xl border border-line bg-panel p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="truncate text-[11px] font-semibold uppercase tracking-[0.12em] text-muted"><%= entry.provider_name %></p>
              <h3 class="mt-1 truncate text-base font-semibold text-ink" title="<%= entry.name %>"><%= entry.name %></h3>
            </div>
            <span class="shrink-0 rounded-full px-2 py-1 text-[10px] font-medium <%= entry.configured ? 'bg-emerald-50 text-success' : 'bg-amber-50 text-warning' %>"><%= entry.configured ? "ready" : "setup" %></span>
          </div>

          <p class="mt-3 break-all font-mono text-xs text-muted"><%= entry.provider %> / <%= entry.id %></p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            <% entry.capability_badges.first(5).each do |capability| %>
              <span class="rounded-md bg-accent-soft px-2 py-1 text-[10px] text-accent"><%= capability_label(capability) %></span>
            <% end %>
            <% if entry.capability_badges.empty? %>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-[10px] text-muted">Capabilities unverified</span>
            <% end %>
          </div>

          <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-4 text-xs">
            <div><dt class="text-muted">Context</dt><dd class="mt-1 font-mono text-ink"><%= entry.context_window ? number_with_delimiter(entry.context_window) : "—" %></dd></div>
            <div><dt class="text-muted">Max output</dt><dd class="mt-1 font-mono text-ink"><%= entry.max_output_tokens ? number_with_delimiter(entry.max_output_tokens) : "—" %></dd></div>
            <div><dt class="text-muted">Input / 1M</dt><dd class="mt-1 font-mono text-ink"><%= model_price(entry.model, :input) %></dd></div>
            <div><dt class="text-muted">Output / 1M</dt><dd class="mt-1 font-mono text-ink"><%= model_price(entry.model, :output) %></dd></div>
          </dl>

          <div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
            <% if @selected_project %>
              <%= link_to "Use model", new_project_chat_path(@selected_project, model_id: entry.id, provider: entry.provider), class: "text-xs font-medium text-accent hover:underline" %>
            <% else %>
              <span class="text-xs text-muted">Project required</span>
            <% end %>
            <% unless entry.configured %>
              <span class="text-right text-[10px] text-warning">Missing <%= entry.missing_configuration.join(", ").presence || "provider configuration" %></span>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>

    <% if @models.empty? %>
      <div class="mt-4 rounded-2xl border border-dashed border-line bg-panel p-8 text-center text-sm text-muted">No models match these filters.</div>
    <% end %>
  </div>
<% end %>
