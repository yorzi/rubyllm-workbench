<article id="message_<%= message.id %>" class="flex justify-start">
  <div class="max-w-3xl rounded-2xl rounded-bl-md border border-line bg-panel px-4 py-3 text-sm leading-6 text-ink shadow-sm">
    <div class="mb-1 flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-accent"><span>Assistant</span><span class="font-normal text-muted">streamed</span></div>
    <div id="message_<%= message.id %>_content" class="whitespace-pre-wrap break-words"><%= message.content %></div>
    <% if message.thinking_text.present? %>
      <details class="mt-3 border-t border-line pt-2 text-xs text-muted"><summary class="cursor-pointer">Thinking</summary><p class="mt-2 whitespace-pre-wrap"><%= message.thinking_text %></p></details>
    <% end %>
    <%= render "messages/provider_tool_activity", message: message %>
    <% if message.citations.any? %>
      <aside class="mt-3 border-t border-line pt-2 text-xs" aria-label="Source citations">
        <p class="font-semibold text-muted">Sources</p>
        <ul class="mt-2 space-y-1">
          <% message.citations.each do |citation| %>
            <% url = citation_link_url(citation) %>
            <% title = citation_value(citation, :title).presence || url || "Source" %>
            <li class="break-words">
              <% if url %><%= link_to title, url, target: "_blank", rel: "noopener noreferrer", class: "text-accent underline decoration-accent/30 underline-offset-2 hover:decoration-accent" %><% else %><span class="text-muted"><%= title %></span><% end %>
            </li>
          <% end %>
        </ul>
      </aside>
    <% end %>
    <% if message.content.present? && message.persisted? %>
      <div class="mt-3 border-t border-line pt-2">
        <% if local_assigns.fetch(:speech_models_available) { speech_models_available? } %>
          <%= link_to "Generate audio Artifact", new_project_chat_message_speech_run_path(message.chat.project, message.chat, message), class: "text-xs font-medium text-accent hover:underline" %>
        <% else %>
          <span aria-disabled="true" title="No RubyLLM speech-generation model is available" class="cursor-not-allowed text-xs font-medium text-muted">Speech unavailable</span>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
