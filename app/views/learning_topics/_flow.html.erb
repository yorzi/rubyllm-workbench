<% if (flow = Learning::Flow.for(topic.key)) %>
  <figure class="rounded-xl border border-line bg-canvas p-3" data-learning-flow="<%= topic.key %>" aria-labelledby="learning-flow-caption">
    <figcaption id="learning-flow-caption" class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Execution map</figcaption>
    <ol class="mt-3">
      <% flow.fetch(:stages).each_with_index do |(label, detail), index| %>
        <% if index.positive? %><li class="py-1 text-center text-accent" aria-hidden="true">↓</li><% end %>
        <li class="rounded-lg border border-line bg-panel px-3 py-2">
          <p class="text-xs font-semibold text-ink"><%= label %></p>
          <p class="mt-1 text-[11px] leading-5 text-muted"><%= detail %></p>
        </li>
      <% end %>
    </ol>
    <ul class="mt-3 space-y-2 border-t border-line pt-3 text-[11px] leading-5 text-muted">
      <% flow.fetch(:branches).each do |branch| %><li><%= branch %></li><% end %>
    </ul>
  </figure>
<% end %>
