<% content_for :title, "#{@collection.name} · Knowledge" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Knowledge inspector</p>
      <span class="rounded-full bg-accent-soft px-2 py-1 text-[10px] font-medium text-accent"><%= @mode %>-v1</span>
    </div>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <p class="font-mono text-xs text-muted">/<%= @project.slug %>/knowledge/<%= @collection.id %></p>
      <h2 class="mt-2 text-base font-semibold text-ink"><%= @collection.name %></h2>
      <p class="mt-2 text-xs leading-5 text-muted"><%= @collection.description.presence || "No collection description yet." %></p>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Sources</dt><dd class="font-mono text-ink"><%= @items.size %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Chunks</dt><dd class="font-mono text-ink"><%= @collection.chunk_count %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Matches</dt><dd class="font-mono text-ink"><%= @results.size %></dd></div>
      </dl>
    </div>
    <div class="mt-4 rounded-xl border border-line bg-panel p-4">
      <div class="flex items-center justify-between gap-3">
        <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">Embeddings</p>
        <span class="rounded-full px-2 py-1 text-[10px] font-medium <%= @collection.embedding_ready? ? 'bg-emerald-50 text-success' : @collection.embedding_status == 'failed' ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-muted' %>"><%= @collection.embedding_status %></span>
      </div>
      <dl class="mt-3 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Model</dt><dd class="truncate font-mono text-ink"><%= @collection.embedding_model_id.presence || "none" %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Dimensions</dt><dd class="font-mono text-ink"><%= @collection.embedding_dimensions || "—" %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Coverage</dt><dd class="font-mono text-ink"><%= @collection.embedded_chunk_count %>/<%= @collection.chunk_count %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Similarity</dt><dd class="font-mono text-ink"><%= @adapter_selection.key %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Rerank</dt><dd class="truncate font-mono text-ink"><%= @outcome&.rerank_applied ? @outcome.rerank_model_id : "off" %></dd></div>
      </dl>
      <% if @collection.embedding_error.present? %>
        <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-xs leading-5 text-rose-700"><%= @collection.embedding_error %></p>
      <% end %>
      <% if @adapter_selection.note.present? %>
        <p class="mt-3 rounded-lg bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-800"><%= @adapter_selection.note %></p>
      <% end %>
    </div>
    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-800">
      <p class="font-medium">Evidence boundary</p>
      <p class="mt-1">Lexical scores are coverage/frequency signals. Semantic scores are cosine similarity over provider embeddings. Neither is a rerank output or an LLM answer.</p>
    </div>
  </div>
<% end %>

<%= render "shared/shell", active: "knowledge", project: @project do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Knowledge", project_knowledge_collections_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-5 border-b border-line pb-6 sm:flex-row sm:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-3xl font-semibold tracking-tight text-ink"><%= @collection.name %></h1>
          <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">local text</span>
          <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted"><%= @collection.embedding_status %></span>
        </div>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-muted"><%= @collection.description.presence || "Searchable local source material for this Project." %></p>
      </div>
    </div>

    <section class="mt-8 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" aria-labelledby="add-source-heading">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="add-source-heading" class="text-sm font-semibold text-ink">Add text source</h2>
          <p class="mt-1 text-xs leading-5 text-muted">Text is normalized, checksummed, synchronously chunked, and stored with character offsets.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-medium text-muted">source_kind: text</span>
      </div>
      <%= form_with url: project_knowledge_collection_items_path(@project, @collection), scope: :knowledge_item, class: "mt-5 space-y-4" do |form| %>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :title, "Source title", class: "text-xs font-medium text-ink" %>
            <%= form.text_field :title, required: true, placeholder: "e.g. Product architecture notes", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
          </div>
          <div>
            <%= form.label :source_reference, "Source reference (optional)", class: "text-xs font-medium text-ink" %>
            <%= form.text_field :source_reference, placeholder: "e.g. meeting-notes-2026-09-16", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
          </div>
        </div>
        <div>
          <%= form.label :content_text, "Source text", class: "text-xs font-medium text-ink" %>
          <%= form.text_area :content_text, rows: 10, required: true, placeholder: "Paste a bounded text source here…", class: "mt-2 w-full resize-y rounded-lg border border-line bg-white px-3 py-3 text-sm leading-6 outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
          <p class="text-xs leading-5 text-muted">Current chunker: 800-character windows with 120-character overlap.</p>
          <%= form.submit "Ingest source", class: "inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
        </div>
      <% end %>
    </section>

    <section class="mt-8 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" aria-labelledby="embeddings-heading">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="embeddings-heading" class="text-sm font-semibold text-ink">Embeddings</h2>
          <p class="mt-1 text-xs leading-5 text-muted">Embedding a collection stores one vector per ready chunk, tied to the model id and chunk checksum.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-medium text-muted"><%= @adapter_selection.key %></span>
      </div>

      <% if @embedding_models.any? %>
        <%= form_with url: project_knowledge_collection_embeddings_path(@project, @collection), scope: :embedding, class: "mt-5 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
          <div class="min-w-0 flex-1">
            <%= form.label :model_id, "Embedding model", class: "text-xs font-medium text-ink" %>
            <%= form.select :model_id,
                  options_for_select(@embedding_models.map { |entry| [ "#{entry.name} · #{entry.id}", entry.id ] }, @collection.embedding_model_id),
                  {},
                  class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 focus:border-accent focus:ring-4" %>
          </div>
          <%= form.submit "Embed collection", class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
        <% end %>
        <p class="mt-3 text-xs leading-5 text-muted"><%= @embedding_models.size %> configured embedding model(s). Unconfigured providers are hidden; re-embedding replaces rows for the same model and leaves other models untouched.</p>
      <% else %>
        <div class="mt-5 rounded-xl border border-dashed border-line bg-canvas p-5 text-sm text-muted">
          No configured embedding model is available. Configure a provider embedding model to enable semantic and hybrid retrieval; lexical retrieval still works without one.
        </div>
      <% end %>

      <% if @collection.knowledge_embeddings.exists? %>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
          <p class="text-xs leading-5 text-muted">
            <%= @collection.embedded_chunk_count %> embedded chunk(s) for <span class="font-mono"><%= @collection.embedding_model_id %></span>
            <% if @collection.embedded_at.present? %> · <%= @collection.embedded_at.strftime("%Y-%m-%d %H:%M") %><% end %>
          </p>
          <%= button_to "Clear embeddings", project_knowledge_collection_embeddings_path(@project, @collection),
                method: :delete,
                class: "inline-flex cursor-pointer items-center rounded-lg border border-line bg-white px-3 py-2 text-xs font-medium text-ink hover:border-rose-300 hover:text-rose-700" %>
        </div>
      <% end %>
    </section>

    <section class="mt-8 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" aria-labelledby="add-document-heading">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="add-document-heading" class="text-sm font-semibold text-ink">Add file source</h2>
          <p class="mt-1 text-xs leading-5 text-muted">Text-like files are extracted locally; PDFs and images need a configured OCR model. Extraction runs in a background job and writes a provenance Artifact.</p>
        </div>
        <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-medium text-muted">source_kind: file</span>
      </div>
      <%= form_with url: project_knowledge_collection_items_path(@project, @collection), scope: :knowledge_item, html: { multipart: true }, class: "mt-5 space-y-4" do |form| %>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <%= form.label :title, "Source title (optional)", class: "text-xs font-medium text-ink" %>
            <%= form.text_field :title, placeholder: "Defaults to the filename", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
          </div>
          <div>
            <%= form.label :document, "File (max 10 MB)", class: "text-xs font-medium text-ink" %>
            <%= form.file_field :document, required: true, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-ink" %>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4">
          <p class="text-xs leading-5 text-muted">Local: <%= Ai::Knowledge::Extractor::LOCALLY_EXTRACTABLE_EXTENSIONS.join(", ") %>. OCR: <%= Ai::Knowledge::Extractor::OCR_EXTRACTABLE_EXTENSIONS.join(", ") %><% if @ocr_models.none? %> — no configured OCR model, so only text-like files can be ingested.<% end %></p>
          <%= form.submit "Upload and extract", class: "inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
        </div>
      <% end %>
    </section>

    <section class="mt-10 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" aria-labelledby="search-heading">
      <div class="flex items-start justify-between gap-3">
        <div>
          <h2 id="search-heading" class="text-sm font-semibold text-ink">Search evidence</h2>
          <p class="mt-1 text-xs leading-5 text-muted">Search ready chunks only. Each match shows its score components, source, and offsets.</p>
        </div>
        <span class="rounded-full bg-accent-soft px-2 py-1 text-[10px] font-medium text-accent">bounded · top 8</span>
      </div>
      <%= form_with url: project_knowledge_collection_path(@project, @collection), method: :get, class: "mt-5 flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
        <div class="min-w-0 flex-1">
          <%= form.label :q, "Query", class: "text-xs font-medium text-ink" %>
          <%= form.search_field :q, value: @query, placeholder: "e.g. SQLite retrieval", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div class="sm:w-44">
          <%= form.label :mode, "Retrieval mode", class: "text-xs font-medium text-ink" %>
          <%= form.select :mode,
                options_for_select(Ai::Knowledge::Search::MODES.map { |mode| [ mode.humanize, mode ] }, @mode),
                {},
                class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 focus:border-accent focus:ring-4" %>
        </div>
        <% if @rerank_models.any? %>
          <div class="sm:w-56">
            <%= form.label :rerank_model_id, "Rerank (compatible providers only)", class: "text-xs font-medium text-ink" %>
            <%= form.select :rerank_model_id,
                  options_for_select(@rerank_models.map { |entry| [ "#{entry.name} · #{entry.id}", entry.id ] }, @rerank_model_id),
                  { include_blank: "Off" },
                  class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 focus:border-accent focus:ring-4" %>
          </div>
          <%= hidden_field_tag :rerank, "1" %>
        <% else %>
          <div class="sm:w-56">
            <p class="text-xs font-medium text-ink">Rerank</p>
            <p class="mt-2 rounded-lg border border-dashed border-line bg-canvas px-3 py-2 text-xs leading-5 text-muted">No configured rerank model; rerank stays off.</p>
          </div>
        <% end %>
        <%= form.submit "Search", class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-line bg-white px-4 py-2.5 text-sm font-medium text-ink hover:border-accent hover:text-accent" %>
      <% end %>

      <% if @outcome && @outcome.rerank_note.present? %>
        <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-800">
          <p class="font-medium">Rerank was not applied — retrieval evidence is unchanged</p>
          <p class="mt-1"><%= @outcome.rerank_note %></p>
        </div>
      <% end %>

      <% if @outcome && @outcome.degraded_reason.present? %>
        <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-800">
          <p class="font-medium"><%= @outcome.requested_mode.humanize %> retrieval was unavailable — lexical evidence shown</p>
          <p class="mt-1"><%= @outcome.degraded_reason %></p>
        </div>
      <% end %>

      <% if @query.present? %>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
          <h3 class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Results for “<%= @query %>”</h3>
          <span class="font-mono text-xs text-muted"><%= @results.size %> matches · <%= @outcome.mode %> · <%= @outcome.adapter_key %><% if @outcome.embedding_model_id.present? %> · <%= @outcome.embedding_model_id %><% end %><% if @outcome.rerank_applied %> · rerank <%= @outcome.rerank_model_id %><% end %></span>
        </div>
        <div class="mt-3 space-y-3">
          <% @results.each_with_index do |result, index| %>
            <article class="rounded-xl border border-line bg-canvas p-4">
              <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                <div class="min-w-0">
                  <h4 class="truncate text-sm font-semibold text-ink"><%= result.chunk.knowledge_item.title %></h4>
                  <p class="mt-1 text-xs text-muted">Chunk <%= result.chunk.position + 1 %> · chars <%= result.chunk.char_start %>–<%= result.chunk.char_end %><% if @outcome.rerank_applied %> · rank <%= index + 1 %><% if result.pre_rank.present? %> (was <%= result.pre_rank + 1 %>)<% end %><% end %></p>
                </div>
                <div class="shrink-0 text-left text-xs sm:text-right">
                  <p class="font-mono font-semibold text-accent">score <%= result.score %></p>
                  <% if result.similarity.present? %>
                    <p class="mt-1 font-mono text-muted">cosine <%= result.similarity %></p>
                  <% end %>
                  <% if result.lexical_score.present? %>
                    <p class="mt-1 font-mono text-muted">lexical <%= result.lexical_score %></p>
                  <% end %>
                  <% if @outcome.rerank_applied && result.rerank_score.present? %>
                    <p class="mt-1 font-mono text-muted">rerank <%= result.rerank_score %></p>
                  <% end %>
                  <% if result.matched_terms.present? %>
                    <p class="mt-1 text-muted">terms: <%= result.matched_terms.join(", ") %></p>
                  <% end %>
                </div>
              </div>
              <pre class="mt-3 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg border border-line bg-white p-3 font-mono text-xs leading-5 text-ink"><%= result.chunk.content_text %></pre>
            </article>
          <% end %>
          <% if @results.empty? %>
            <div class="rounded-xl border border-dashed border-line bg-canvas p-5 text-sm text-muted">No ready chunk matched this query.</div>
          <% end %>
        </div>
      <% else %>
        <div class="mt-5 rounded-xl border border-dashed border-line bg-canvas p-5 text-sm text-muted">Enter a query to inspect retrieval evidence from this collection.</div>
      <% end %>
    </section>

    <section class="mt-10" aria-labelledby="sources-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="sources-heading" class="text-sm font-semibold text-ink">Sources</h2>
        <span class="font-mono text-xs text-muted"><%= @items.size %> recorded</span>
      </div>
      <div class="mt-3 space-y-3">
        <% @items.each do |item| %>
          <article class="rounded-xl border border-line bg-panel p-4">
            <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="truncate text-sm font-semibold text-ink"><%= item.title %></h3>
                  <span class="rounded-full px-2 py-1 text-[10px] font-medium <%= item.ready? ? 'bg-emerald-50 text-success' : item.failed? ? 'bg-rose-50 text-rose-700' : 'bg-amber-50 text-warning' %>"><%= item.ingestion_status %></span>
                </div>
                <p class="mt-2 text-xs text-muted"><%= item.filename.presence || "Inline text source" %> · <%= item.chunk_count %> chunks · <%= item.knowledge_embeddings.ready.count %> embedded<% if item.file_source? %> · extraction <%= item.extraction_status %><% if item.extractor.present? %> via <%= item.extractor %><% end %><% end %></p>
              </div>
              <p class="shrink-0 font-mono text-[10px] text-muted">sha256:<%= item.checksum.first(12) %></p>
            </div>
            <% if item.error_summary.present? %>
              <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-xs leading-5 text-rose-700"><%= item.error_summary %></p>
            <% end %>
            <% if item.extraction_error.present? %>
              <p class="mt-3 rounded-lg bg-rose-50 px-3 py-2 text-xs leading-5 text-rose-700"><%= item.extraction_error %></p>
            <% end %>
            <% artifact = item.extraction_artifact %>
            <% if artifact %>
              <details class="mt-3 rounded-lg border border-line bg-canvas p-3">
                <summary class="cursor-pointer text-xs font-medium text-ink">Extraction provenance · <%= artifact.metadata_json["extractor"] %><% if artifact.metadata_json["model_id"].present? %> · <%= artifact.metadata_json["model_id"] %><% end %></summary>
                <dl class="mt-3 grid gap-2 text-[11px] text-muted sm:grid-cols-2">
                  <% artifact.metadata_json.slice("filename", "content_type", "bytes", "page_count", "provider", "model_id", "blob_checksum", "content_checksum", "extracted_at").each do |key, value| %>
                    <div class="min-w-0"><dt class="inline"><%= key.humanize %>: </dt><dd class="inline break-all font-mono text-ink"><%= value %></dd></div>
                  <% end %>
                </dl>
                <pre class="mt-3 max-h-40 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-white p-3 font-mono text-[11px] leading-5 text-muted"><%= artifact.content_text.to_s.truncate(1_500) %></pre>
              </details>
            <% end %>
          </article>
        <% end %>
        <% if @items.empty? %>
          <div class="rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted">No sources yet. Add local text above to create inspectable chunks.</div>
        <% end %>
      </div>
    </section>
  </div>
<% end %>
