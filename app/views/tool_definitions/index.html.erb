<% content_for :title, "Tools · #{@project.name}" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3"><p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Tool Lab</p><span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">M3</span></div>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4"><p class="text-xs leading-5 text-muted">Tools are Ruby-defined registry entries. Enabling one adds it to the next chat Run snapshot; browser input cannot upload or execute Ruby.</p><dl class="mt-4 divide-y divide-line border-t border-line text-xs"><div class="flex justify-between gap-3 py-3"><dt class="text-muted">Project</dt><dd class="max-w-[10rem] truncate text-right text-ink"><%= @project.name %></dd></div><div class="flex justify-between gap-3 py-3"><dt class="text-muted">Registered</dt><dd class="font-mono text-ink"><%= @tool_definitions.size %></dd></div><div class="flex justify-between gap-3 py-3"><dt class="text-muted">Enabled</dt><dd class="font-mono text-ink"><%= @tool_definitions.count(&:enabled?) %></dd></div></dl></div>
  </div>
<% end %>

<%= render "shared/shell", active: "tools", project: @project do %>
  <div class="mx-auto max-w-5xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← #{@project.name}", project_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-end"><div><h1 class="text-3xl font-semibold tracking-tight text-ink">Tool Lab</h1><p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Inspect the code-defined tools available to this Project and decide which ones may be included in future chat Runs.</p></div><%= link_to "Return to project", project_path(@project), class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %></div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      <% @tool_definitions.each do |tool_definition| %>
        <article class="rounded-xl border border-line bg-panel p-5">
          <div class="flex items-start justify-between gap-3"><div class="min-w-0"><h2 class="truncate text-sm font-semibold text-ink"><%= tool_definition.name %></h2><p class="mt-1 font-mono text-[11px] text-muted"><%= tool_definition.key %></p></div><span class="rounded-full px-2 py-1 text-[10px] font-medium <%= tool_definition.enabled? ? 'bg-emerald-50 text-success' : 'bg-slate-100 text-muted' %>"><%= tool_definition.enabled? ? 'enabled' : 'disabled' %></span></div>
          <p class="mt-4 text-sm leading-6 text-muted"><%= tool_definition.description %></p>
          <dl class="mt-4 grid grid-cols-2 gap-3 border-y border-line py-3 text-xs"><div><dt class="text-muted">Approval</dt><dd class="mt-1 font-mono text-ink"><%= tool_definition.approval_policy %></dd></div><div><dt class="text-muted">Registry</dt><dd class="mt-1 font-mono text-ink"><%= tool_definition.class_identifier %></dd></div></dl>
          <details class="mt-4 rounded-lg bg-canvas p-3"><summary class="cursor-pointer text-xs font-medium text-ink">Inspect JSON Schema</summary><pre class="mt-3 max-h-56 overflow-auto whitespace-pre-wrap break-words font-mono text-[11px] leading-5 text-muted"><%= JSON.pretty_generate(tool_definition.schema_json) %></pre></details>
          <%= form_with model: tool_definition, url: project_tool_definition_path(@project, tool_definition), method: :patch, class: "mt-4 flex items-center justify-between gap-3" do |form| %><%= form.hidden_field :enabled, value: tool_definition.enabled? ? "0" : "1" %><span class="text-xs text-muted"><%= tool_definition.enabled? ? 'Included in new chat Runs.' : 'Excluded from new chat Runs.' %></span><%= form.submit(tool_definition.enabled? ? "Disable" : "Enable", class: "cursor-pointer rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent") %><% end %>
        </article>
      <% end %>
    </div>
  </div>
<% end %>
