<%= form_with model: [@project, @dataset], scope: :evaluation_dataset, class: "mt-8 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" do |form| %>
  <% if @dataset.errors.any? || @revision&.errors&.any? %>
    <div class="mb-5 rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm leading-5 text-rose-700"><%= (@dataset.errors.full_messages + Array(@revision&.errors&.full_messages)).uniq.to_sentence %></div>
  <% end %>
  <div>
    <%= form.label :name, "Dataset name", class: "text-xs font-medium text-ink" %>
    <%= form.text_field :name, required: true, placeholder: "e.g. Support-answer checks", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
  </div>
  <div class="mt-5">
    <%= form.label :description, "Description (optional)", class: "text-xs font-medium text-ink" %>
    <%= form.text_area :description, rows: 2, class: "mt-2 w-full resize-y rounded-lg border border-line bg-white px-3 py-2.5 text-sm leading-6 outline-none ring-accent/20 focus:border-accent focus:ring-4" %>
  </div>
  <div class="mt-5">
    <%= label_tag "evaluation_dataset_cases_json", "Cases JSON", class: "text-xs font-medium text-ink" %>
    <%= text_area_tag "evaluation_dataset[cases_json]", @cases_text, id: "evaluation_dataset_cases_json", rows: 20, required: true, spellcheck: false, class: "mt-2 w-full resize-y rounded-lg border border-line bg-slate-950 px-3 py-3 font-mono text-xs leading-5 text-slate-100 outline-none ring-accent/20 focus:border-accent focus:ring-4" %>
    <p class="mt-2 text-xs leading-5 text-muted">Use 1–100 cases. Each object needs a unique <code>key</code>, an <code>input</code>, and an <code>expected_output</code> JSON value. Optional <code>tags</code> accept up to 12 short strings. An optional <code>rubric</code> array can define 1–8 criteria, for example <code>[{ "key": "accuracy", "description": "Factual accuracy" }]</code>; completed cases can receive one human rating per criterion. Tags and rubric are saved with the immutable revision but stay out of provider prompts. Expected output is only used by the local exact-match evaluator and is also excluded from the provider prompt.</p>
  </div>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-5">
    <%= link_to "Cancel", @dataset.persisted? ? project_evaluation_dataset_path(@project, @dataset) : project_evaluation_datasets_path(@project), class: "text-sm text-muted hover:text-ink" %>
    <%= form.submit @dataset.persisted? ? "Save immutable revision" : "Create dataset", class: "inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
  </div>
<% end %>
