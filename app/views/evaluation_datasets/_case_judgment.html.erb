<% judgment = case_result.evaluation_case_judgment %>
<% if judgment %>
  <div class="mt-3 rounded-lg border border-indigo-100 bg-indigo-50/60 p-3">
    <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-indigo-900">Automated rubric judge · <%= judgment.status.humanize %></p>
    <% if judgment.run %>
      <p class="mt-1 text-[10px] text-muted"><%= link_to "Judge Run ##{judgment.run.id}", run_path(judgment.run), class: "font-mono font-medium text-accent hover:underline" %> · additional cost <%= format_cost(judgment.run.total_cost, status: judgment.run.cost_status) %></p>
    <% end %>
    <% if judgment.completed? %>
      <dl class="mt-2 space-y-1 text-[10px] text-muted">
        <% Array(judgment.input_snapshot["rubric"]).each do |criterion| %>
          <div class="flex items-start justify-between gap-3"><dt><%= criterion.fetch("key") %></dt><dd class="font-medium text-ink"><%= judgment.result.dig("ratings", criterion.fetch("key")) %></dd></div>
        <% end %>
      </dl>
      <% if judgment.result["rationale"].present? %><p class="mt-2 text-[10px] leading-4 text-muted"><%= judgment.result["rationale"] %></p><% end %>
    <% end %>
    <% if judgment.error_summary.present? %><p class="mt-2 text-[10px] leading-4 text-rose-700"><%= judgment.error_summary %></p><% end %>
    <% if judgment.submission_unknown? %><p class="mt-2 text-[10px] leading-4 text-amber-800">The provider outcome is unknown. This started judge request will not be replayed automatically.</p><% end %>
  </div>
<% elsif case_result.completed? && case_result.rubric.any? && case_result.evaluation_execution.input_snapshot["judge"].present? %>
  <p class="mt-2 text-[10px] text-muted">Automated rubric judge queued when this case completed.</p>
<% end %>
