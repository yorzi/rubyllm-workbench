<% content_for :title, "Edit #{@dataset.name} · #{@project.name}" %>
<%= render "shared/shell", active: "evaluations", project: @project do %>
  <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 lg:px-10">
    <%= link_to "← #{@dataset.name}", project_evaluation_dataset_path(@project, @dataset), class: "text-xs font-medium text-accent hover:underline" %>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">Create a dataset revision</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Revision history stays immutable. Existing evaluation executions continue to reference the revision they started with.</p>
    <%= render "form" %>
  </div>
<% end %>
