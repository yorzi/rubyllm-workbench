<% content_for :title, "#{@dataset.name} · #{@project.name}" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Evaluation dataset</p>
    <div class="mt-4 rounded-xl border border-line bg-panel p-4">
      <p class="font-mono text-xs text-muted">revision <%= @dataset.current_revision %></p>
      <h2 class="mt-2 text-base font-semibold text-ink"><%= @dataset.name %></h2>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Cases</dt><dd class="font-mono text-ink"><%= @revision&.cases&.size || 0 %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Executions</dt><dd class="font-mono text-ink"><%= @executions.size %></dd></div>
      </dl>
    </div>
    <%= link_to "Edit / add revision", edit_project_evaluation_dataset_path(@project, @dataset), class: "mt-4 inline-flex w-full items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
  </div>
<% end %>

<%= render "shared/shell", active: "evaluations", project: @project do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Evaluations", project_evaluation_datasets_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-4 border-b border-line pb-6 sm:flex-row sm:items-start">
      <div>
        <div class="flex flex-wrap items-center gap-2"><h1 class="text-3xl font-semibold tracking-tight text-ink"><%= @dataset.name %></h1><span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">v<%= @dataset.current_revision %></span></div>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-muted"><%= @dataset.description.presence || "Versioned structured-output evaluation cases." %></p>
      </div>
      <%= link_to "Edit", edit_project_evaluation_dataset_path(@project, @dataset), class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
    </div>

    <section class="mt-8 rounded-xl border border-line bg-panel p-5" aria-labelledby="evaluation-run-heading">
      <div>
        <h2 id="evaluation-run-heading" class="text-sm font-semibold text-ink">Evaluate a structured Experiment</h2>
        <p class="mt-1 text-xs leading-5 text-muted">Compare 2–5 configured structured-output models against the same immutable dataset revision and Experiment snapshot. Each model and case keeps its own Run, Attempt and exact JSON comparison. Expected output stays local.</p>
      </div>
      <% if @revision && @experiments.any? && @models.any? %>
        <%= form_with url: project_evaluation_dataset_executions_path(@project, @dataset), method: :post, scope: :execution, class: "mt-4 grid gap-4 md:grid-cols-[1fr_1fr_1fr_auto] md:items-end" do |form| %>
          <div>
            <%= form.label :experiment_id, "Structured Experiment", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
            <%= form.select :experiment_id, options_from_collection_for_select(@experiments, :id, :name), {}, required: true, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm" %>
          </div>
          <div>
            <%= form.label :model_references, "Configured models (select 2–5)", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
            <%= form.select :model_references, options_for_select(@models.map { |entry| ["#{entry.provider_name} · #{entry.name}", "#{entry.provider}|#{entry.id}"] }), {}, multiple: true, size: 5, required: true, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2 text-sm" %>
          </div>
          <div>
            <%= form.label :judge_model_reference, "Optional rubric judge", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
            <%= form.select :judge_model_reference, options_for_select([["Disabled", ""]] + @judge_models.map { |entry| ["#{entry.provider_name} · #{entry.name}", "#{entry.provider}|#{entry.id}"] }), {}, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm" %>
          </div>
          <%= form.submit "Queue comparison", class: "inline-flex cursor-pointer items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-xs font-medium text-white shadow-sm hover:bg-indigo-700" %>
        <% end %>
        <p class="mt-2 text-[10px] leading-4 text-muted">Selecting a judge sends each eligible case's input, generated output, and rubric to the selected judge provider; expected output, tags, and attachments are excluded. It adds up to one provider request per successful case with a rubric. Judge Runs and costs are recorded separately; exact-match results and human reviews are unchanged.</p>
        <% if @batch_models.any? %>
          <div class="mt-5 border-t border-line pt-4">
            <p class="text-xs font-semibold text-ink">Provider Batch API</p>
            <p class="mt-1 max-w-3xl text-xs leading-5 text-muted">Submits all cases together for supported Anthropic or Gemini models. Provider processing can take longer than individual Runs. If submission becomes uncertain before its ID is saved, the app will mark it and will not submit it again automatically.</p>
            <%= form_with url: project_evaluation_dataset_executions_path(@project, @dataset), method: :post, scope: :execution, class: "mt-3 grid gap-4 md:grid-cols-[1fr_1fr_1fr_auto] md:items-end" do |form| %>
              <%= form.hidden_field :execution_mode, value: "provider_batch" %>
              <div>
                <%= form.label :experiment_id, "Structured Experiment", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
                <%= form.select :experiment_id, options_from_collection_for_select(@experiments, :id, :name), {}, required: true, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm" %>
              </div>
              <div>
                <%= form.label :model_reference, "Batch-capable model", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
                <%= form.select :model_reference, options_for_select(@batch_models.map { |entry| ["#{entry.provider_name} · #{entry.name}", "#{entry.provider}|#{entry.id}"] }), {}, required: true, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm" %>
              </div>
              <div>
                <%= form.label :judge_model_reference, "Optional rubric judge", class: "block text-[10px] font-semibold uppercase tracking-[0.14em] text-muted" %>
                <%= form.select :judge_model_reference, options_for_select([["Disabled", ""]] + @judge_models.map { |entry| ["#{entry.provider_name} · #{entry.name}", "#{entry.provider}|#{entry.id}"] }), {}, class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm" %>
              </div>
              <%= form.submit "Submit provider batch", class: "inline-flex cursor-pointer items-center justify-center rounded-lg border border-accent px-4 py-2.5 text-xs font-medium text-accent hover:bg-indigo-50" %>
            <% end %>
            <p class="mt-2 text-[10px] leading-4 text-muted">Selecting a judge sends each eligible case's input, generated output, and rubric to the selected judge provider; expected output, tags, and attachments are excluded. It adds up to one separate provider request per successful case with a rubric after batch results arrive.</p>
          </div>
        <% end %>
      <% else %>
        <p class="mt-4 rounded-lg border border-dashed border-line bg-canvas p-4 text-xs leading-5 text-muted">Create a dataset revision, a runnable structured Experiment, and configure one structured-output model to start an evaluation.</p>
      <% end %>
    </section>

    <% if @comparisons.any? %>
      <section class="mt-10" aria-labelledby="evaluation-comparison-heading">
        <div class="flex items-center justify-between gap-3"><h2 id="evaluation-comparison-heading" class="text-sm font-semibold text-ink">Cross-model comparison summaries</h2><span class="font-mono text-xs text-muted"><%= @comparisons.size %> recent</span></div>
        <p class="mt-2 text-xs leading-5 text-muted">Exact JSON matches describe structural agreement with the expected output. Human reviews add a separate, self-reported judgment and do not change automated results or provider metrics.</p>
        <div class="mt-3 space-y-5">
          <% @comparisons.each do |comparison| %>
            <% executions = comparison.evaluation_executions.to_a %>
            <% cases = executions.flat_map { |execution| execution.evaluation_case_results.to_a }.group_by(&:case_key) %>
            <% case_tags = comparison.evaluation_dataset_revision.cases.index_by { |item| item.fetch("key") }.transform_values { |item| item.fetch("tags", []) } %>
            <article class="rounded-xl border border-line bg-panel p-5">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div><h3 class="font-mono text-sm font-semibold text-ink">Comparison #<%= comparison.id %></h3><p class="mt-1 text-xs text-muted">Dataset revision <%= comparison.evaluation_dataset_revision.revision %> · <%= comparison.experiment_snapshot['name'] %> v<%= comparison.experiment_snapshot['revision'] %> · <%= executions.size %> models</p></div>
                <p class="text-xs text-muted"><%= comparison.created_at.strftime("%Y-%m-%d %H:%M UTC") %></p>
              </div>
              <div class="mt-4 overflow-x-auto rounded-lg border border-line">
                <table class="min-w-full text-left text-xs">
                  <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted"><tr><th class="px-3 py-2 font-semibold">Model</th><th class="px-3 py-2 font-semibold">Passed</th><th class="px-3 py-2 font-semibold">Failed / mismatch</th><th class="px-3 py-2 font-semibold">Pending / unknown</th><th class="px-3 py-2 font-semibold">Metrics</th></tr></thead>
                  <tbody class="divide-y divide-line">
                    <% executions.each do |execution| %>
                      <% results = execution.evaluation_case_results.to_a %>
                      <% pending_count = results.count { |result| result.queued? || result.running? || result.submission_unknown? } %>
                      <tr>
                        <td class="whitespace-nowrap px-3 py-3 font-mono text-ink"><%= execution.provider %> / <%= execution.model_id %></td>
                        <td class="px-3 py-3 text-ink"><%= execution.passed_count %> / <%= execution.case_count %></td>
                        <td class="px-3 py-3 text-ink"><%= execution.failed_count %></td>
                        <td class="px-3 py-3 text-ink"><%= pending_count %></td>
                        <td class="px-3 py-3"><%= render "evaluation_datasets/metrics", metrics: @evaluation_metrics.fetch(execution.id), execution:, compact: true %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
              <div class="mt-4 overflow-x-auto rounded-lg border border-line">
                <table class="min-w-full text-left text-xs">
                  <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted"><tr><th class="px-3 py-2 font-semibold">Case</th><% executions.each do |execution| %><th class="min-w-40 px-3 py-2 font-semibold"><%= execution.model_id %></th><% end %></tr></thead>
                  <tbody class="divide-y divide-line">
                    <% cases.sort_by { |key, _| key }.each do |case_key, grouped_results| %>
                      <% results_by_execution = grouped_results.index_by(&:evaluation_execution_id) %>
                      <tr>
                        <td class="px-3 py-3 font-mono text-ink"><div><%= case_key %></div><% if Array(case_tags.fetch(case_key, [])).any? %><div class="mt-1 flex flex-wrap gap-1"><% Array(case_tags.fetch(case_key)).each do |tag| %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-sans text-muted"><%= tag %></span><% end %></div><% end %></td>
                        <% executions.each do |execution| %>
                          <% case_result = results_by_execution[execution.id] %>
                          <td id="<%= dom_id(case_result) %>" class="px-3 py-3">
                            <% if case_result %>
                              <span class="rounded-full px-2 py-1 text-[10px] font-medium <%= case_result.passed? ? 'bg-emerald-50 text-success' : (case_result.failed? || case_result.passed == false ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-muted') %>"><%= case_result.failed? ? "run failed" : case_result.submission_unknown? ? "submission unknown" : case_result.passed.nil? ? case_result.status : (case_result.passed? ? "passed" : "mismatch") %></span>
                              <div class="mt-2"><%= case_result.run ? link_to("Run ##{case_result.run.id}", run_path(case_result.run), class: "font-mono font-medium text-accent hover:underline") : "—" %></div>
                              <div class="mt-1 text-[10px] text-muted"><%= case_result.run ? format_cost(case_result.run.total_cost, status: case_result.run.cost_status) : "—" %></div>
                              <%= render "evaluation_datasets/case_judgment", case_result: %>
                              <%= render "evaluation_datasets/case_attachments", revision: case_result.evaluation_dataset_revision, case_key:, allow_mutations: false %>
                              <%= render "evaluation_datasets/case_review", case_result: %>
                            <% else %>
                              <span class="text-muted">No result</span>
                            <% end %>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <section class="mt-8 rounded-xl border border-line bg-panel p-5" aria-labelledby="dataset-cases-heading">
      <div class="flex items-center justify-between gap-3"><h2 id="dataset-cases-heading" class="text-sm font-semibold text-ink">Current cases</h2><span class="font-mono text-xs text-muted">revision <%= @revision&.revision || "—" %></span></div>
      <div class="mt-4 overflow-x-auto rounded-lg border border-line">
        <table class="min-w-full text-left text-xs">
          <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted"><tr><th class="px-3 py-2 font-semibold">Case</th><th class="px-3 py-2 font-semibold">Tags</th><th class="px-3 py-2 font-semibold">Input JSON</th><th class="px-3 py-2 font-semibold">Expected JSON</th><th class="px-3 py-2 font-semibold">Attachments</th></tr></thead>
          <tbody class="divide-y divide-line">
            <% Array(@revision&.cases).each do |evaluation_case| %>
              <tr><td class="whitespace-nowrap px-3 py-3 font-mono text-ink"><%= evaluation_case.fetch("key") %></td><td class="px-3 py-3"><div class="flex flex-wrap gap-1"><% Array(evaluation_case["tags"]).each do |tag| %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] text-muted"><%= tag %></span><% end %></div></td><td class="px-3 py-3"><pre class="max-w-sm whitespace-pre-wrap break-words font-mono text-[10px] leading-4 text-muted"><%= JSON.pretty_generate(evaluation_case.fetch("input")) %></pre></td><td class="px-3 py-3"><pre class="max-w-sm whitespace-pre-wrap break-words font-mono text-[10px] leading-4 text-muted"><%= JSON.pretty_generate(evaluation_case.fetch("expected_output")) %></pre></td><td class="px-3 py-3"><%= render "evaluation_datasets/case_attachments", revision: @revision, case_key: evaluation_case.fetch("key"), allow_mutations: true %></td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="evaluation-history-heading">
      <div class="flex items-center justify-between gap-3"><h2 id="evaluation-history-heading" class="text-sm font-semibold text-ink">Execution history</h2><span class="font-mono text-xs text-muted"><%= @executions.size %> recorded</span></div>
      <div class="mt-3 space-y-4">
        <% @executions.each do |execution| %>
          <article class="rounded-xl border border-line bg-panel p-5">
            <% case_tags = execution.evaluation_dataset_revision.cases.index_by { |item| item.fetch("key") }.transform_values { |item| item.fetch("tags", []) } %>
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div><h3 class="font-mono text-sm font-semibold text-ink">Evaluation #<%= execution.id %></h3><p class="mt-1 text-xs text-muted">v<%= execution.evaluation_dataset_revision.revision %> · <%= execution.provider %> / <%= execution.model_id %></p></div>
              <div class="flex flex-wrap items-center gap-2"><span class="rounded-full px-2 py-1 text-[10px] font-medium <%= status_classes(execution.status) %>"><%= execution.status %></span><% if execution.individual? && execution.evaluation_case_results.queued.any? %><%= button_to "Resume unstarted cases", resume_project_evaluation_dataset_execution_path(@project, @dataset, execution), method: :post, class: "cursor-pointer rounded-lg border border-line px-3 py-2 text-[10px] font-medium text-ink hover:border-accent hover:text-accent" %><% end %><% if execution.evaluation_case_judgments.queued.where("evaluation_case_judgments.error_summary LIKE ?", "#{EvaluationCaseJudgment::ENQUEUE_REJECTION_PREFIX}%").exists? %><%= button_to "Resume rejected rubric judges", resume_judgments_project_evaluation_dataset_execution_path(@project, @dataset, execution), method: :post, class: "cursor-pointer rounded-lg border border-line px-3 py-2 text-[10px] font-medium text-ink hover:border-accent hover:text-accent" %><% end %><% if execution.provider_batch? && execution.running? && execution.provider_batch_id.present? %><%= button_to "Refresh provider batch", refresh_project_evaluation_dataset_execution_path(@project, @dataset, execution), method: :post, class: "cursor-pointer rounded-lg border border-line px-3 py-2 text-[10px] font-medium text-ink hover:border-accent hover:text-accent" %><% end %><% if execution.manually_closable_unknown_submission? %><%= button_to "Close as unresolved failure", close_unknown_project_evaluation_dataset_execution_path(@project, @dataset, execution), method: :post, form: { data: { turbo_confirm: "This only fails the local Runs. It cannot cancel a provider request that may have been accepted, and a new evaluation may duplicate its cost. Close this unresolved result?" } }, class: "cursor-pointer rounded-lg border border-rose-200 px-3 py-2 text-[10px] font-medium text-rose-700 hover:bg-rose-50" %><% end %></div>
            </div>
            <p class="mt-3 text-xs text-muted"><%= execution.completed_count %> / <%= execution.case_count %> complete · <%= execution.passed_count %> passed · <%= execution.failed_count %> failed<% if execution.submission_unknown_count.positive? %> · <%= execution.submission_unknown_count %> submission unknown<% end %></p>
            <%= render "evaluation_datasets/metrics", metrics: @evaluation_metrics.fetch(execution.id), execution:, compact: false %>
            <% if execution.provider_batch? %>
              <p class="mt-2 text-[10px] text-muted">Provider batch <span class="font-mono"><%= execution.provider_batch_id.presence || "ID not saved" %></span> · <%= execution.provider_batch_status.presence || execution.status %><% if execution.provider_batch_raw_status.present? %> (<%= execution.provider_batch_raw_status %>)<% end %><% if execution.provider_batch_refreshed_at %> · refreshed <%= l(execution.provider_batch_refreshed_at, format: :short) %><% end %></p>
              <% if execution.provider_batch_error.present? %><p class="mt-2 max-w-3xl text-xs text-rose-700"><%= execution.provider_batch_error %></p><% end %>
              <% if execution.submission_unknown? %><p class="mt-2 max-w-3xl text-[11px] leading-5 text-amber-800">The request may have reached the provider. Automatic resubmission is disabled. The recovery worker will keep checking the local RubyLLM batch store; after 30 minutes without reconciliation, manual closure only marks these local Runs failed and cannot stop provider processing.</p><% end %>
            <% end %>
            <div class="mt-4 overflow-x-auto rounded-lg border border-line">
              <table class="min-w-full text-left text-xs">
                <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted"><tr><th class="px-3 py-2 font-semibold">Case</th><th class="px-3 py-2 font-semibold">Result</th><th class="px-3 py-2 font-semibold">Run evidence</th><th class="px-3 py-2 font-semibold">Cost</th></tr></thead>
                <tbody class="divide-y divide-line">
                  <% execution.evaluation_case_results.each do |case_result| %>
                    <tr>
                      <td class="px-3 py-3 font-mono text-ink"><div><%= case_result.case_key %></div><% if Array(case_tags.fetch(case_result.case_key, [])).any? %><div class="mt-1 flex flex-wrap gap-1"><% Array(case_tags.fetch(case_result.case_key)).each do |tag| %><span class="rounded-full bg-slate-100 px-2 py-0.5 text-[10px] font-sans text-muted"><%= tag %></span><% end %></div><% end %></td>
                      <td class="px-3 py-3"><span class="rounded-full px-2 py-1 text-[10px] font-medium <%= case_result.passed? ? 'bg-emerald-50 text-success' : (case_result.failed? || case_result.passed == false ? 'bg-rose-50 text-rose-700' : 'bg-slate-100 text-muted') %>"><%= case_result.failed? ? "run failed" : case_result.submission_unknown? ? "submission unknown" : case_result.passed.nil? ? case_result.status : (case_result.passed? ? "passed" : "mismatch") %></span><% if case_result.error_summary.present? %><p class="mt-2 max-w-sm text-[10px] leading-4 text-rose-700"><%= case_result.error_summary %></p><% end %></td>
                      <td id="<%= dom_id(case_result) %>" class="px-3 py-3"><%= case_result.run ? link_to("Run ##{case_result.run.id}", run_path(case_result.run), class: "font-mono font-medium text-accent hover:underline") : "—" %><% if case_result.actual_output_json %><details class="mt-2"><summary class="cursor-pointer text-[10px] text-muted">Actual JSON</summary><pre class="mt-2 max-w-sm whitespace-pre-wrap break-words font-mono text-[10px] leading-4 text-muted"><%= JSON.pretty_generate(case_result.actual_output_json) %></pre></details><% end %><%= render "evaluation_datasets/case_judgment", case_result: %><%= render "evaluation_datasets/case_attachments", revision: case_result.evaluation_dataset_revision, case_key: case_result.case_key, allow_mutations: false %><%= render "evaluation_datasets/case_review", case_result: %></td>
                      <td class="whitespace-nowrap px-3 py-3 text-muted"><%= case_result.run ? format_cost(case_result.run.total_cost, status: case_result.run.cost_status) : "—" %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </article>
        <% end %>
        <% if @executions.empty? %><div class="rounded-xl border border-dashed border-line bg-panel p-8 text-center text-sm text-muted">No evaluation executions yet.</div><% end %>
      </div>
    </section>
  </div>
<% end %>
