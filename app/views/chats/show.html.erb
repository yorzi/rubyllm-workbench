<% content_for :title, "#{@chat.display_title.presence || 'Chat'} · #{@project.name}" %>
<% turbo_stream_from @chat.stream_key %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Run inspector</p>
      <% if @latest_run %><%= render "runs/status", run: @latest_run %><% end %>
    </div>

    <% if @latest_run %>
      <div class="mt-5 rounded-xl border border-line bg-panel p-4">
        <%= link_to "Run ##{@latest_run.id}", run_path(@latest_run), class: "font-mono text-xs font-medium text-accent hover:underline" %>
        <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
          <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Operation</dt><dd class="font-mono text-ink"><%= @latest_run.operation %></dd></div>
          <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Duration</dt><dd class="text-ink"><%= format_duration(@latest_run.duration_ms) %></dd></div>
          <div class="flex justify-between gap-3 py-3"><dt class="text-muted">First output</dt><dd class="text-ink"><%= format_duration(@latest_run.time_to_first_output_ms) %></dd></div>
          <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Tokens</dt><dd class="font-mono text-right text-ink"><%= format_tokens(@latest_run.total_tokens[:input]) %> in / <%= format_tokens(@latest_run.total_tokens[:output]) %> out</dd></div>
          <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Cost</dt><dd class="text-right text-ink"><%= format_cost(@latest_run.total_cost, status: @latest_run.cost_status) %></dd></div>
        </dl>
      </div>
      <% if @latest_run.error_summary.present? %>
        <div class="mt-4 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs leading-5 text-rose-700"><p class="font-medium">Diagnostic</p><p class="mt-1 break-words"><%= @latest_run.error_summary %></p></div>
      <% end %>
    <% else %>
      <div class="mt-5 rounded-xl border border-dashed border-line bg-panel p-4 text-xs leading-5 text-muted">No Run yet. Submit a message to create one.</div>
    <% end %>
  </div>
<% end %>

<%= render "shared/shell", active: "projects", project: @project do %>
  <div class="mx-auto flex min-h-screen max-w-5xl flex-col px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>

    <div class="flex flex-col justify-between gap-4 border-b border-line pb-5 sm:flex-row sm:items-start">
      <div class="min-w-0">
        <%= link_to "← #{@project.name}", project_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
        <h1 class="mt-3 truncate text-2xl font-semibold tracking-tight text-ink"><%= @chat.display_title.presence || "Untitled chat" %></h1>
        <p class="mt-2 break-all font-mono text-xs text-muted"><%= @chat.provider %> / <%= @chat.model_id %></p>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to "Change model", new_project_chat_path(@project), class: "rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
        <%= button_to "Delete", project_chat_path(@project, @chat), method: :delete, form: { data: { turbo_confirm: "Delete this chat and its runs?" } }, class: "rounded-lg border border-rose-200 px-3 py-2 text-xs font-medium text-rose-700 hover:bg-rose-50" %>
      </div>
    </div>

    <% unless @provider_configured %>
      <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs leading-5 text-warning" role="status">
        This chat is browseable, but its provider is not configured. Add <span class="font-mono"><%= @model_entry&.missing_configuration&.join(", ").presence || "provider configuration" %></span> through the environment or Rails credentials before running it.
      </div>
    <% end %>

    <div id="messages" class="flex-1 space-y-4 py-6" aria-live="polite">
      <% @messages.each do |message| %>
        <%= render message %>
      <% end %>
      <% if @messages.empty? %>
        <div class="rounded-2xl border border-dashed border-line bg-panel p-8 text-center">
          <p class="text-sm font-medium text-ink">This chat is ready.</p>
          <p class="mt-2 text-sm leading-5 text-muted">Submit a small prompt to exercise streaming and inspect the resulting Run.</p>
        </div>
      <% end %>
    </div>

    <div class="sticky bottom-0 -mx-5 border-t border-line bg-canvas/95 px-5 py-4 backdrop-blur sm:-mx-8 sm:px-8 lg:-mx-10 lg:px-10">
      <%= form_with model: [@project, @chat, Message.new], data: { controller: "form-state", action: "turbo:submit-start->form-state#start turbo:submit-end->form-state#finish" }, class: "rounded-2xl border border-line bg-panel p-3 shadow-sm" do |form| %>
        <%= form.label :content, "Message", class: "sr-only" %>
        <%= form.text_area :content, rows: 3, required: true, placeholder: "Ask the selected model something…", class: "w-full resize-y border-0 bg-transparent px-2 py-1 text-sm leading-6 text-ink outline-none placeholder:text-slate-400 focus:ring-0" %>
        <div class="mt-2 flex items-center justify-between gap-3 border-t border-line px-2 pt-2">
          <p class="text-[11px] text-muted">Run data and messages are persisted locally.</p>
          <%= form.submit "Run", disabled: !@provider_configured, title: (@provider_configured ? nil : "Configure the provider first"), data: { form_state_target: "submit" }, class: "cursor-pointer rounded-lg bg-accent px-4 py-2 text-xs font-medium text-white enabled:hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-50" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
