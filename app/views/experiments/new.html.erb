<% content_for :title, "New experiment · #{@project.name}" %>
<%= render "shared/shell", active: "experiments", project: @project do %>
  <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Experiments", project_experiments_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">New experiment</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-muted">Define one reproducible prompt and schema. Models are selected only when you execute it.</p>
    <%= render "form" %>
  </div>
<% end %>
