<% content_for :title, "#{@experiment.name} · #{@project.name}" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between gap-3">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Experiment inspector</p>
      <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success"><%= @experiment.status %></span>
    </div>
    <%= render "shared/learning_link", topic: "experiment_comparison" %>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <p class="font-mono text-xs text-muted">v<%= @experiment.revision %> · <%= @experiment.schema_definition.name %></p>
      <h2 class="mt-2 text-base font-semibold text-ink"><%= @experiment.name %></h2>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Executions</dt><dd class="font-mono text-ink"><%= @executions.size %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Models shown</dt><dd class="font-mono text-ink"><%= @models.size %></dd></div>
      </dl>
    </div>
    <%= link_to "Edit definition", edit_project_experiment_path(@project, @experiment), class: "mt-4 inline-flex w-full items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" unless demo_mode? %>
  </div>
<% end %>

<%= render "shared/shell", active: "experiments", project: @project do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← Experiments", project_experiments_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
    <div class="mt-3 flex flex-col justify-between gap-5 border-b border-line pb-6 sm:flex-row sm:items-start">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h1 class="text-3xl font-semibold tracking-tight text-ink"><%= @experiment.name %></h1>
          <span class="rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted">v<%= @experiment.revision %></span>
        </div>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-muted"><%= @experiment.description.presence || "A reusable structured-output definition." %></p>
      </div>
      <%= link_to "Edit", edit_project_experiment_path(@project, @experiment), class: "inline-flex items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" unless demo_mode? %>
    </div>

    <div class="mt-8 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <section class="rounded-xl border border-line bg-panel p-5" aria-labelledby="definition-heading">
        <h2 id="definition-heading" class="text-sm font-semibold text-ink">Frozen definition</h2>
        <dl class="mt-4 space-y-4 text-sm">
          <div><dt class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">System instructions</dt><dd class="mt-1 whitespace-pre-wrap break-words leading-6 text-ink"><%= @experiment.system_prompt.presence || "None" %></dd></div>
          <div><dt class="text-[10px] font-semibold uppercase tracking-[0.14em] text-muted">User prompt</dt><dd class="mt-1 whitespace-pre-wrap break-words leading-6 text-ink"><%= @experiment.input_prompt %></dd></div>
        </dl>
        <details class="mt-5 border-t border-line pt-4">
          <summary class="cursor-pointer text-xs font-medium text-accent">View schema JSON</summary>
          <pre class="mt-3 max-h-80 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-slate-950 p-4 font-mono text-xs leading-5 text-slate-100"><%= JSON.pretty_generate(@experiment.schema_json) %></pre>
        </details>
      </section>

      <% if demo_mode? %>
        <section class="rounded-xl border border-line bg-panel p-5">
          <h2 class="text-sm font-semibold text-ink">Follow this definition into an evaluation</h2>
          <p class="mt-2 text-xs leading-5 text-muted">The synthetic evaluation compares two models against the same frozen schema and dataset. Inspect an exact match and a valid-schema mismatch, then follow each case to its Run.</p>
          <%= link_to "Inspect evaluation results", project_evaluation_datasets_path(@project), class: "mt-4 inline-flex text-xs font-medium text-accent underline underline-offset-2" %>
        </section>
      <% end %>

      <% unless demo_mode? %>
    <section class="rounded-xl border border-line bg-panel p-5" aria-labelledby="run-experiment-heading">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 id="run-experiment-heading" class="text-sm font-semibold text-ink">Run comparison</h2>
            <p class="mt-1 text-xs leading-5 text-muted">Choose two or more configured models. Each target gets an independent Run and Attempt.</p>
          </div>
          <span class="rounded-full bg-accent-soft px-2 py-1 text-[10px] font-medium text-accent"><%= @models.size %> shown</span>
        </div>
        <% if @models.size >= 2 %>
          <%= form_with url: project_experiment_executions_path(@project, @experiment), method: :post, scope: :execution, class: "mt-5" do |form| %>
            <div class="max-h-96 space-y-2 overflow-y-auto rounded-lg border border-line bg-canvas p-2">
              <% @models.each do |entry| %>
                <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-transparent bg-white px-3 py-3 hover:border-accent has-[:checked]:border-accent has-[:checked]:bg-accent-soft">
                  <%= check_box_tag "execution[models][]", "#{entry.provider}|#{entry.id}", @default_model_ids.include?("#{entry.provider}|#{entry.id}"), class: "mt-0.5 rounded border-line text-accent focus:ring-accent" %>
                  <span class="min-w-0">
                    <span class="block truncate text-xs font-medium text-ink"><%= entry.provider_name %> · <%= entry.name %></span>
                    <span class="mt-1 block break-all font-mono text-[10px] text-muted"><%= entry.provider %> / <%= entry.id %></span>
                  </span>
                </label>
              <% end %>
            </div>
            <%= form.submit "Run selected models", class: "mt-4 inline-flex cursor-pointer items-center rounded-lg bg-accent px-4 py-2.5 text-xs font-medium text-white shadow-sm hover:bg-indigo-700" %>
          <% end %>
        <% else %>
          <div class="mt-5 rounded-lg border border-dashed border-line bg-canvas p-4 text-xs leading-5 text-muted">At least two configured models with structured-output capability are required. Configure another provider or refresh the RubyLLM registry.</div>
        <% end %>
      </section>
    <% end %>
    </div>

    <section class="mt-10" aria-labelledby="execution-history-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="execution-history-heading" class="text-sm font-semibold text-ink">Execution history</h2>
        <span class="font-mono text-xs text-muted"><%= @executions.size %> recorded</span>
      </div>
      <div class="mt-3 space-y-4">
        <% @executions.each do |execution| %>
          <article class="rounded-xl border border-line bg-panel p-5">
            <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-center">
              <div>
                <div class="flex items-center gap-2"><h3 class="font-mono text-sm font-semibold text-ink">Execution #<%= execution.id %></h3><span class="rounded-full px-2 py-1 text-[10px] font-medium <%= status_classes(execution.status) %>"><%= execution.status %></span></div>
                <p class="mt-1 text-xs text-muted"><%= execution.completed_count %> / <%= execution.target_count %> targets complete · <%= time_ago_in_words(execution.created_at) %> ago</p>
                <% if execution.error_summary.present? %><p class="mt-2 max-w-2xl text-xs leading-5 text-rose-700"><%= execution.error_summary %></p><% end %>
              </div>
              <% targets = execution.input_snapshot.fetch("targets", []) %>
              <% if !demo_mode? && targets.size >= 2 %>
                <%= form_with url: project_experiment_executions_path(@project, @experiment), method: :post, scope: :execution, class: "shrink-0" do |form| %>
                  <% targets.each do |target| %>
                    <%= hidden_field_tag "execution[models][]", "#{target["provider"]}|#{target["model_id"]}" %>
                  <% end %>
                  <%= form.submit "Run again", class: "inline-flex cursor-pointer items-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
                <% end %>
              <% end %>
            </div>
            <div class="mt-4 overflow-x-auto rounded-lg border border-line">
              <table class="min-w-full text-left text-xs">
                <thead class="border-b border-line bg-canvas text-[10px] uppercase tracking-[0.12em] text-muted"><tr><th class="px-3 py-2 font-semibold">Model</th><th class="px-3 py-2 font-semibold">Run</th><th class="px-3 py-2 font-semibold">Schema</th><th class="px-3 py-2 font-semibold">Cost</th></tr></thead>
                <tbody class="divide-y divide-line">
                  <% execution.runs.each do |run| %>
                    <tr>
                      <td class="px-3 py-3"><span class="block font-medium text-ink"><%= run.chat.provider %></span><span class="mt-1 block max-w-[18rem] truncate font-mono text-muted"><%= run.chat.model_id %></span></td>
                      <td class="px-3 py-3"><%= link_to "Run ##{run.id}", run_path(run), class: "font-mono font-medium text-accent hover:underline" %><span class="mt-1 block rounded-full px-2 py-1 text-[10px] font-medium <%= status_classes(run.status) %> w-fit"><%= run.status %></span></td>
                      <td class="px-3 py-3 text-muted"><%= run.result_summary["schema_validation"].presence || "pending" %></td>
                      <td class="whitespace-nowrap px-3 py-3 text-muted"><%= format_cost(run.total_cost, status: run.cost_status) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </article>
        <% end %>
        <% if @executions.empty? && !demo_mode? %>
          <div class="rounded-xl border border-dashed border-line bg-panel p-8 text-center text-sm text-muted">No executions yet. Select models above to create the first comparison.</div>
        <% end %>
      </div>
    </section>
  </div>
<% end %>
