<% content_for :title, "Edit #{@experiment.name} · #{@project.name}" %>
<%= render "shared/shell", active: "experiments", project: @project do %>
  <div class="mx-auto max-w-4xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>
    <%= link_to "← #{@experiment.name}", project_experiment_path(@project, @experiment), class: "text-xs font-medium text-accent hover:underline" %>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink">Edit experiment</h1>
    <p class="mt-2 text-sm leading-6 text-muted">Saving creates a new revision for future executions. Existing Run snapshots remain unchanged.</p>
    <%= render "form" %>
  </div>
<% end %>
