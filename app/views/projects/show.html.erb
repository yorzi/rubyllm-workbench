<% content_for :title, "#{@project.name} · RubyLLM Workbench" %>
<% content_for :inspector do %>
  <div class="sticky top-0">
    <div class="flex items-center justify-between">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Project inspector</p>
      <span class="rounded-full bg-emerald-50 px-2 py-1 text-[10px] font-medium text-success"><%= demo_mode? ? "synthetic" : "local" %></span>
    </div>
    <%= render "shared/learning_link", topic: "project_boundary" %>
    <div class="mt-5 rounded-xl border border-line bg-panel p-4">
      <p class="font-mono text-xs text-muted">/<%= @project.slug %></p>
      <h2 class="mt-2 text-base font-semibold text-ink"><%= @project.name %></h2>
      <p class="mt-2 text-xs leading-5 text-muted"><%= @project.description.presence || "No project description yet." %></p>
      <dl class="mt-4 divide-y divide-line border-t border-line text-xs">
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Chats</dt><dd class="font-mono text-ink"><%= @project.chats.count %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Runs</dt><dd class="font-mono text-ink"><%= @project.runs.count %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Knowledge</dt><dd class="font-mono text-ink"><%= @project.knowledge_collections.count %></dd></div>
        <div class="flex justify-between gap-3 py-3"><dt class="text-muted">Created</dt><dd class="text-right text-ink"><%= l(@project.created_at, format: :short) %></dd></div>
      </dl>
    </div>
    <%= link_to "Browse models", models_path(project_id: @project.slug), class: "mt-4 inline-flex w-full items-center justify-center rounded-lg border border-line px-3 py-2 text-xs font-medium text-ink hover:border-accent hover:text-accent" %>
  </div>
<% end %>

<%= render "shared/shell", active: "projects", project: @project do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <%= link_to "← Projects", root_path, class: "text-xs font-medium text-accent hover:underline" %>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink"><%= @project.name %></h1>
        <p class="mt-2 text-sm text-muted"><%= @project.description.presence || "A clean local boundary for model experiments." %></p>
      </div>
      <%= link_to "New chat", new_project_chat_path(@project), class: "inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" unless demo_mode? %>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-4">
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Chats</p><p class="mt-2 text-2xl font-semibold text-ink"><%= @project.chats.count %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Experiments</p><p class="mt-2 text-2xl font-semibold text-ink"><%= @project.experiments.count %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Runs</p><p class="mt-2 text-2xl font-semibold text-ink"><%= @project.runs.count %></p></div>
      <div class="rounded-xl border border-line bg-panel p-4"><p class="text-[10px] uppercase tracking-[0.14em] text-muted">Agents</p><p class="mt-2 text-2xl font-semibold text-ink"><%= @project.agent_definitions.count %></p></div>
    </div>

    <section class="mt-10" aria-labelledby="experiments-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="experiments-heading" class="text-sm font-semibold text-ink">Experiments</h2>
        <%= link_to "Open workspace", project_experiments_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        <% @project.experiments.order(updated_at: :desc).limit(4).each do |experiment| %>
          <%= link_to project_experiment_path(@project, experiment), class: "rounded-xl border border-line bg-panel p-4 hover:border-accent" do %>
            <div class="flex items-center justify-between gap-3"><h3 class="truncate text-sm font-medium text-ink"><%= experiment.name %></h3><span class="font-mono text-[10px] text-muted">v<%= experiment.revision %></span></div>
            <p class="mt-2 truncate text-xs text-muted"><%= experiment.input_prompt %></p>
          <% end %>
        <% end %>
        <% if @project.experiments.none? %>
          <%= link_to "Create a schema-backed experiment", new_project_experiment_path(@project), class: "rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted hover:border-accent hover:text-accent" unless demo_mode? %>
        <% end %>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="agents-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="agents-heading" class="text-sm font-semibold text-ink">Agent definitions</h2>
        <%= link_to "Open workspace", project_agent_definitions_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        <% @project.agent_definitions.order(updated_at: :desc).limit(4).each do |agent_definition| %>
          <%= link_to project_agent_definition_path(@project, agent_definition), class: "rounded-xl border border-line bg-panel p-4 hover:border-accent" do %>
            <div class="flex items-center justify-between gap-3"><h3 class="truncate text-sm font-medium text-ink"><%= agent_definition.name %></h3><span class="font-mono text-[10px] text-muted">v<%= agent_definition.revision %></span></div>
            <p class="mt-2 truncate font-mono text-[11px] text-muted"><%= agent_definition.provider %> / <%= agent_definition.model_id %></p>
          <% end %>
        <% end %>
        <% if @project.agent_definitions.none? %>
          <%= link_to "Create a reusable agent definition", new_project_agent_definition_path(@project), class: "rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted hover:border-accent hover:text-accent" unless demo_mode? %>
        <% end %>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="knowledge-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="knowledge-heading" class="text-sm font-semibold text-ink">Knowledge</h2>
        <%= link_to "Open workspace", project_knowledge_collections_path(@project), class: "text-xs font-medium text-accent hover:underline" %>
      </div>
      <div class="mt-3 rounded-xl border border-line bg-panel p-5">
        <p class="text-sm font-medium text-ink">Local text, inspectable evidence</p>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-muted"><%= demo_mode? ? "Search the example Rails sources locally, then inspect matching text, chunk offsets and checksums. Embeddings, reranking and uploads are disabled in this demo." : "Paste or upload a source, split it into deterministic chunks, and inspect bounded lexical, semantic, hybrid, and optional rerank evidence. Provider file references and page-level provenance are not implemented yet." %></p>
      </div>
    </section>

    <div class="mt-10 grid gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <section aria-labelledby="recent-chats-heading">
        <div class="flex items-center justify-between gap-3">
          <h2 id="recent-chats-heading" class="text-sm font-semibold text-ink">Recent chats</h2>
          <%= link_to "New", new_project_chat_path(@project), class: "text-xs font-medium text-accent hover:underline" unless demo_mode? %>
        </div>
        <div class="mt-3 space-y-3">
          <% @chats.each do |chat| %>
            <%= link_to project_chat_path(@project, chat), class: "block rounded-xl border border-line bg-panel p-4 hover:border-accent" do %>
              <div class="flex items-center justify-between gap-3">
                <h3 class="truncate text-sm font-medium text-ink"><%= chat.display_title.presence || "Untitled chat" %></h3>
                <span class="shrink-0 rounded-full bg-slate-100 px-2 py-1 font-mono text-[10px] text-muted"><%= chat.provider %></span>
              </div>
              <p class="mt-2 truncate font-mono text-xs text-muted"><%= chat.model_id %></p>
              <p class="mt-3 text-xs text-muted"><%= chat.messages.count %> messages · updated <%= time_ago_in_words(chat.updated_at) %> ago</p>
            <% end %>
          <% end %>
          <% if @chats.empty? %>
            <div class="rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted">No chats yet. Choose a configured model to open one.</div>
          <% end %>
        </div>
      </section>

      <section aria-labelledby="recent-runs-heading">
        <div class="flex items-center justify-between gap-3">
          <h2 id="recent-runs-heading" class="text-sm font-semibold text-ink">Recent runs</h2>
          <span class="font-mono text-xs text-muted">inspectable</span>
        </div>
        <div class="mt-3 space-y-3">
          <% @runs.each do |run| %>
            <%= render "runs/row", run: run %>
          <% end %>
          <% if @runs.empty? %>
            <div class="rounded-xl border border-dashed border-line bg-panel p-5 text-sm text-muted">Runs appear here after a chat message is submitted.</div>
          <% end %>
        </div>
      </section>
    </div>
  </div>
<% end %>
