<% content_for :title, "Projects · RubyLLM Workbench" %>
<% content_for :inspector do %>
  <%= render "shared/runtime_inspector" %>
  <%= render "shared/learning_link", topic: "project_boundary", label: "How Projects work" %>
<% end %>

<%= render "shared/shell", active: "projects" do %>
  <div class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:px-10">
    <%= render "shared/flash" %>

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-accent">Local AI workbench</p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Projects</h1>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">Keep model choices, prompts, streamed messages, and execution evidence together in a small Rails-native workspace.</p>
      </div>
      <%= link_to "Open Model Explorer", models_path, class: "inline-flex items-center justify-center rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-white shadow-sm hover:bg-indigo-700" %>
    </div>

    <section class="mt-8" aria-labelledby="projects-heading">
      <div class="flex items-center justify-between gap-3">
        <h2 id="projects-heading" class="text-sm font-semibold text-ink">Your projects</h2>
        <span class="font-mono text-xs text-muted"><%= @projects.size %> total</span>
      </div>

      <div class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        <% @projects.each do |project| %>
          <%= link_to project_path(project), class: "group rounded-2xl border border-line bg-panel p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent" do %>
            <div class="flex items-start justify-between gap-3">
              <span class="grid size-9 place-items-center rounded-xl bg-accent-soft font-mono text-xs font-semibold text-accent"><%= project.name.first(2).upcase %></span>
              <span class="font-mono text-[11px] text-muted">/<%= project.slug %></span>
            </div>
            <h3 class="mt-5 text-base font-semibold text-ink group-hover:text-accent"><%= project.name %></h3>
            <p class="mt-2 min-h-10 text-sm leading-5 text-muted"><%= project.description.presence || "No project description yet." %></p>
            <div class="mt-5 flex items-center justify-between border-t border-line pt-3 text-xs text-muted">
              <span><%= project.chats.count %> chats</span>
              <span><%= project.runs.count %> runs</span>
            </div>
          <% end %>
        <% end %>

        <% if @projects.empty? %>
          <div class="rounded-2xl border border-dashed border-line bg-panel p-6 text-sm text-muted md:col-span-2 xl:col-span-3">
            No projects yet. Create the first one below; browsing the model catalog does not require a provider key.
          </div>
        <% end %>
      </div>
    </section>

    <section id="new-project" class="mt-10 rounded-2xl border border-line bg-panel p-5 shadow-sm sm:p-6" aria-labelledby="new-project-heading">
      <div class="max-w-xl">
        <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-muted">Foundation</p>
        <h2 id="new-project-heading" class="mt-2 text-lg font-semibold text-ink">Create a project</h2>
        <p class="mt-2 text-sm leading-5 text-muted">A project is the durable context boundary for chats and runs. The slug is derived when left blank.</p>
      </div>

      <%= form_with model: @project, class: "mt-6 grid gap-4 sm:grid-cols-2" do |form| %>
        <% if @project.errors.any? %>
          <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2 text-sm text-rose-700 sm:col-span-2">
            <%= @project.errors.full_messages.to_sentence %>
          </div>
        <% end %>
        <div>
          <%= form.label :name, class: "text-xs font-medium text-ink" %>
          <%= form.text_field :name, required: true, autofocus: @projects.empty?, placeholder: "e.g. RubyLLM experiments", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div>
          <%= form.label :slug, class: "text-xs font-medium text-ink" %>
          <%= form.text_field :slug, placeholder: "ruby-llm-experiments", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 font-mono text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div class="sm:col-span-2">
          <%= form.label :description, class: "text-xs font-medium text-ink" %>
          <%= form.text_area :description, rows: 3, placeholder: "What are you trying to learn or build?", class: "mt-2 w-full rounded-lg border border-line bg-white px-3 py-2.5 text-sm outline-none ring-accent/20 placeholder:text-slate-400 focus:border-accent focus:ring-4" %>
        </div>
        <div class="sm:col-span-2">
          <%= form.submit "Create project", class: "inline-flex cursor-pointer items-center rounded-lg bg-ink px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-700" %>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
