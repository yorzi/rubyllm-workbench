# Copy to .env for bin/dev (Foreman loads it). bin/rails does not load .env.
# Leave keys empty to browse models and explore the synthetic demo tour.
OPENROUTER_API_KEY=
# Test-only policy. bin/dogfood overrides these in its serial live subprocess.
# Standalone commands do not load this file; use Rails credentials or a secure
# environment injection. Flags do not replace user authorization for live calls.
AI_TEST_PROFILE=mock
RUN_LIVE_AI=0
# Optional explicit model overrides for bin/dogfood (recheck current pricing):
# DOGFOOD_CHAT_MODEL=
# DOGFOOD_STRUCTURED_MODEL=
# DOGFOOD_TOOLS_MODEL=
# DOGFOOD_EMBEDDING_MODEL=
# DOGFOOD_RERANK_MODEL=
# DOGFOOD_SPEECH_MODEL=fish-audio/s2.1-pro-free:free
# DOGFOOD_SPEECH_VOICE=
# AI_* model/budget/token variables from generic examples are not implemented.
# See docs/AI_USAGE_GUIDE.md before adding configuration.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HETZNER_API_KEY=
# TYPESAFE_API_KEY=

# For Docker: copy to .env.production and set a locally generated runtime key.
# SECRET_KEY_BASE=
# SOLID_QUEUE_IN_PUMA=1

# Isolated read-only viewer: prepare with bin/demo prepare; see docs/DEMO.md.
# Do not combine this mode with SOLID_QUEUE_IN_PUMA or database URL overrides.
# WORKBENCH_DEMO=1
