#!/usr/bin/env ruby
# Runs the opt-in live provider dogfood suite and prints a summary table.
#
#   bin/dogfood           free-model scenarios only
#   bin/dogfood --paid    deliberately allow fee-bearing/manual scenarios
#
# Needs a configured provider (OpenRouter by default; see
# test/live/provider_dogfood_test.rb for model overrides). Results are appended
# to tmp/dogfood/<timestamp>.jsonl for copying into docs/CAPABILITIES.md.
require "fileutils"
require "json"
require "time"

APP_ROOT = File.expand_path("..", __dir__)
paid = ARGV.delete("--paid")
report = File.join(APP_ROOT, "tmp/dogfood", "#{Time.now.utc.strftime('%Y%m%dT%H%M%SZ')}.jsonl")
FileUtils.mkdir_p(File.dirname(report))

env = {
  "LIVE_DOGFOOD" => "1",
  "LIVE_DOGFOOD_PAID" => paid ? "1" : nil,
  "DOGFOOD_REPORT" => report,
  "PARALLEL_WORKERS" => "1"
}
Dir.chdir(APP_ROOT) do
  system(env, "bin/rails", "test", "test/live/provider_dogfood_test.rb", *ARGV)
end
status = $?.exitstatus

rows = File.exist?(report) ? File.readlines(report).map { |line| JSON.parse(line) } : []
abort "No dogfood results were recorded." if rows.empty?

display = ->(value) { value.nil? ? "unknown" : value }
puts "\n| Scenario | Result | Models | Runs | POST requests | Tokens in/out (Runs only) | Known Run cost (USD) | Coverage | Notes |"
puts "| --- | --- | --- | --- | --- | --- | --- | --- | --- |"
rows.sort_by { |row| row["scenario"] }.each do |row|
  notes = [ row["skip_reason"], row["failure"], *row["notes"] ].compact.uniq.join("; ").gsub("|", "\\|")
  coverage = if row["result"] == "skip" && row["run_ids"].empty?
    "not called"
  elsif row["cost_complete"]
    "Run attempts complete"
  else
    "incomplete: #{row['unknown_cost_attempts']} unknown Attempts; #{row['untracked_cost_operations'].join(', ')}"
  end
  puts "| #{row['scenario']} | #{row['result']} | #{row['models'].join(', ')} | #{row['run_ids'].join(', ')} | " \
       "#{display.call(row['http_post_requests'])} | #{display.call(row['input_tokens'])}/#{display.call(row['output_tokens'])} | #{display.call(row['known_cost'])} | #{coverage} | #{notes} |"
end
total = rows.sum { |row| row["known_cost"].to_f }
puts "\nRubyLLM #{rows.first['ruby_llm']} · #{rows.count { |row| row['result'] == 'pass' }} passed · " \
     "#{rows.count { |row| row['result'] == 'fail' }} failed · #{rows.count { |row| row['result'] == 'skip' }} manual/skipped · " \
     "known Run cost subtotal $#{total.round(6)} (unknown costs excluded) · #{report}"
exit status
